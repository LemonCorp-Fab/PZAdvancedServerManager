# Linux fallback only: copy this file to .env and restrict it to mode 600.
# Windows users should run `just docker-secret-setup` to use DPAPI instead.
PZASM_ADMIN_USERNAME=admin
PZASM_ADMIN_PASSWORD=replace-with-a-long-unique-password
PZASM_ADMIN_DISPLAY_NAME=Server administrator
PZASM_DATA_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
PZASM_BIND_ADDRESS=127.0.0.1
PZASM_HTTP_PORT=5160
