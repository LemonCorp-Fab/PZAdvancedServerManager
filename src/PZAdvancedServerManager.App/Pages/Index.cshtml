@page
@model IndexModel
@{
    ViewData["Title"] = "Tableau de bord";
    var enabledModCount = Model.Projects.Sum(project => project.Mods.Count(mod => mod.Enabled));
    var publishedProjectCount = Model.Projects.Count(project => project.PublishedWorkshopId != 0);
    var readyProjectCount = Model.Projects.Count(project => project.LastBuiltAt is not null && !project.PortableSourcesRequired);
}

@if (TempData["Message"] is string message)
{
    <div class="toast-message">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="error-message">@error</div>
}

<section class="hero">
    <div>
        <span class="eyebrow">LEMONCORP · PROJECT ZOMBOID</span>
        <h1>Vos serveurs. Vos versions. Votre cadence.</h1>
        <p>Regroupez les mods d'un serveur sous un seul Workshop ID, conservez chaque Mod ID intact et choisissez vous-même le moment des mises à jour.</p>
    </div>
    <div class="hero-mark" aria-hidden="true"><svg class="ui-icon"><use href="#icon-forest-landscape"></use></svg><span>PZASM</span></div>
</section>

<section class="dashboard-summary-grid" aria-label="Résumé opérationnel">
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon" aria-hidden="true"><svg class="ui-icon"><use href="#icon-package"></use></svg></span>
        <div><span>Modpacks</span><strong>@Model.Projects.Count</strong><small>@readyProjectCount prêt(s) à déployer</small></div>
    </article>
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon is-success" aria-hidden="true"><svg class="ui-icon"><use href="#icon-layers"></use></svg></span>
        <div><span>Mods actifs</span><strong>@enabledModCount.ToString("N0")</strong><small>Versions suivies et figées</small></div>
    </article>
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon is-info" aria-hidden="true"><svg class="ui-icon"><use href="#icon-workshop"></use></svg></span>
        <div><span>Workshop</span><strong>@publishedProjectCount</strong><small>Pack(s) publié(s)</small></div>
    </article>
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon @(Model.SteamCmdStatus.Installed ? "is-success" : "is-warning")" aria-hidden="true"><svg class="ui-icon"><use href="#icon-terminal"></use></svg></span>
        <div><span>SteamCMD</span><strong>@(Model.SteamCmdStatus.Installed ? "Prêt" : "Requis")</strong><small>@(Model.SteamCmdStatus.Installed ? "Téléchargements opérationnels" : "Installation en un clic")</small></div>
    </article>
</section>

<div class="legal-banner">
    <strong>Responsabilité de l'éditeur du pack</strong>
    <span>PZ Advanced Server Manager ne donne aucun droit de redistribution. Même pour un pack non listé ou réservé à un serveur, vérifiez l'autorisation de chaque auteur. LemonCorp n'est pas responsable des packs créés par les utilisateurs.</span>
</div>

<section class="dashboard-grid">
    <article class="panel">
        <div class="panel-heading">
            <div><span class="eyebrow">INSTALLATION LOCALE</span><h2>Project Zomboid détecté</h2></div>
            <form method="post" asp-page-handler="RefreshDiscovery" data-loading-title="Analyse de l’installation…" data-loading-detail="Recherche du jeu, du serveur dédié, de SteamCMD et des contenus Workshop locaux."><button class="button ghost" type="submit">Actualiser</button></form>
        </div>
        <dl class="path-list">
            <dt>Jeu</dt><dd>@(Model.Installation.ClientRoot ?? "Non détecté")</dd>
            <dt>Serveur dédié</dt><dd>@(Model.Installation.DedicatedServerRoot ?? "Non détecté")</dd>
            <dt>Workshop 108600</dt><dd>@(Model.Installation.WorkshopRoot ?? "Non détecté")</dd>
            <dt>SteamCMD</dt><dd>@(Model.Installation.SteamCmdPath ?? "Non installé")</dd>
            <dt>Données PZASM</dt><dd>@Model.DataRoot</dd>
        </dl>
        <div class="dashboard-actions">
            <a class="button secondary" asp-page="/Server/Index">Gérer les serveurs</a>
            <form method="post" asp-page-handler="InstallSteamCmd" data-operation-progress data-loading-title="Installation de SteamCMD…" data-loading-detail="Téléchargement depuis Valve, extraction dans l’espace portable du gestionnaire et première initialisation." data-loading-steps="Téléchargement officiel|Extraction contrôlée|Initialisation Steam|Vérification finale" data-loading-phase-map="steamcmd-missing:0,steamcmd-download:0,steamcmd-extract:1,steamcmd-bootstrap:2,steamcmd-ready:3"><button class="button @(Model.SteamCmdStatus.Installed ? "ghost" : "primary")" type="submit">@(Model.SteamCmdStatus.Installed ? "Réinstaller / vérifier" : "Préparer SteamCMD maintenant")</button></form>
        </div>
    </article>

    <article class="panel create-panel">
        <span class="eyebrow">NOUVEAU PROJET</span>
        <h2>Créer un pack stable</h2>
        <p>Le suffixe unique du projet restera identique à chaque réouverture et mise à jour.</p>
        <form method="post" asp-page="/Modpacks/Index" asp-page-handler="Create" class="stack-form" data-loading-title="Création du pack…" data-loading-detail="Préparation du projet, de son identifiant stable et de son espace de snapshots.">
            <label for="name">Nom du pack</label>
            <input id="name" name="name" required maxlength="120" placeholder="Ex. Lemon Valley — serveur principal" />
            <button class="button primary" type="submit">Créer le pack</button>
        </form>
        <a class="inline-navigation-link" asp-page="/Modpacks/Index">Voir et gérer tous les modpacks <span aria-hidden="true">→</span></a>
    </article>
</section>
