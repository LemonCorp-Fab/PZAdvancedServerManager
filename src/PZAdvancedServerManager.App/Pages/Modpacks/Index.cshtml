@page
@model ModpacksModel
@{
    ViewData["Title"] = "Modpacks";
    var enabledModCount = Model.Projects.Sum(project => project.Mods.Count(mod => mod.Enabled));
    var publishedProjectCount = Model.Projects.Count(project => project.PublishedWorkshopId != 0);
    var readyProjectCount = Model.Projects.Count(project => project.LastBuiltAt is not null && !project.PortableSourcesRequired);
}

@if (TempData["Message"] is string message)
{
    <div class="toast-message">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="error-message">@error</div>
}

<section class="workspace-hero modpacks-page-hero">
    <div>
        <span class="eyebrow">BIBLIOTHÈQUE DE MODPACKS</span>
        <h1>Construisez, transférez et publiez vos packs.</h1>
        <p>Chaque projet conserve son identifiant, son ordre de chargement, ses versions figées et son historique de publication.</p>
    </div>
    <a class="button primary" href="#new-modpack">Créer un modpack</a>
</section>

<section class="dashboard-summary-grid modpacks-summary-grid" aria-label="Résumé des modpacks">
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon" aria-hidden="true">PK</span>
        <div><span>Modpacks</span><strong>@Model.Projects.Count</strong><small>@readyProjectCount prêt(s) localement</small></div>
    </article>
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon is-success" aria-hidden="true">MD</span>
        <div><span>Mods actifs</span><strong>@enabledModCount.ToString("N0")</strong><small>Tous projets confondus</small></div>
    </article>
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon is-info" aria-hidden="true">WS</span>
        <div><span>Workshop</span><strong>@publishedProjectCount</strong><small>Pack(s) publié(s)</small></div>
    </article>
    <article class="dashboard-summary-card">
        <span class="dashboard-summary-icon is-warning" aria-hidden="true">TR</span>
        <div><span>Transfert</span><strong>2</strong><small>Formats léger et complet</small></div>
    </article>
</section>

<div class="legal-banner">
    <strong>Responsabilité de l’éditeur du pack</strong>
    <span>PZ Advanced Server Manager ne donne aucun droit de redistribution. Vérifiez l’autorisation de chaque auteur avant de partager ou publier un pack.</span>
</div>

<section class="modpack-tools-grid" aria-label="Création et import de modpacks">
    <article class="panel create-panel" id="new-modpack">
        <span class="eyebrow">NOUVEAU PROJET</span>
        <h2>Créer un pack stable</h2>
        <p>Le suffixe unique restera identique à chaque réouverture et mise à jour.</p>
        <form method="post" asp-page-handler="Create" class="stack-form" data-loading-title="Création du pack…" data-loading-detail="Préparation du projet, de son identifiant stable et de son espace de snapshots.">
            <label for="name">Nom du pack</label>
            <input id="name" name="name" required maxlength="120" placeholder="Ex. Lemon Valley — serveur principal" />
            <button class="button primary" type="submit">Créer le pack</button>
        </form>
    </article>

    <article class="panel modpack-import-panel">
        <span class="eyebrow">TRANSFERT ENTRE ADMINISTRATEURS</span>
        <h2>Importer un pack portable</h2>
        <p>Restaurez la même identité, le Workshop ID, l’ordre des mods, les droits et l’automatisation sur un autre manager.</p>
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportPack" class="stack-form" data-loading-title="Import du pack portable…" data-loading-detail="Envoi de l’archive, validation de chaque blob puis installation atomique dans l’espace de ce manager." data-loading-steps="Envoi de l’archive|Lecture du manifeste|Vérification SHA-256|Reconstruction dédupliquée|Installation transactionnelle" data-confirm-title="Importer ce pack ?" data-confirm-message="L’identité du pack et son Workshop ID seront conservés. Une archive légère sera bloquée jusqu’au téléchargement de ses sources. Si le remplacement est activé, le projet local sera remplacé uniquement après validation intégrale." data-confirm-action="Vérifier et importer">
            <label><span>Archive portable</span><input type="file" name="archive" accept=".pzasm-pack,application/vnd.pzasm.pack+zip" required /></label>
            <label class="switch-row"><input type="checkbox" name="replaceExisting" value="true" /><span><strong>Remplacer le même pack s’il existe</strong><small>Désactivé par défaut. Le remplacement exige le même identifiant stable et reste transactionnel.</small></span></label>
            <button class="button primary" type="submit">Importer le pack</button>
        </form>
        <div class="transfer-note"><strong>Choisissez le bon format</strong><span>L’export léger ne transporte ni mods ni build. L’archive complète embarque les versions figées sous forme de blobs dédupliqués. La session Steam n’est jamais exportée.</span></div>
    </article>
</section>

<section class="section-heading" id="projects">
    <div><span class="eyebrow">MODPACKS ENREGISTRÉS</span><h2>Reprendre ou mettre à jour un pack</h2></div>
    <span class="count-pill">@Model.Projects.Count</span>
</section>

@if (Model.Projects.Count == 0)
{
    <div class="empty-state"><h3>Aucun modpack pour le moment</h3><p>Créez un projet ou importez une archive portable. Il apparaîtra ici avec son état et ses actions.</p></div>
}
else
{
    <div class="project-grid modpack-project-grid">
        @foreach (var project in Model.Projects)
        {
            <article class="project-card">
                <a class="project-card-main" asp-page="/Projects/Edit" asp-route-id="@project.Id" data-loading-title="Ouverture du pack…" data-loading-detail="Chargement du projet, de ses sources et de son état de validation.">
                    <div class="project-top"><span class="mode-badge">@(project.Mode == PackageMode.Bundle ? "BUNDLE CONSEILLÉ" : "FUSION STRICTE")</span><span>@project.UpdatedAt.LocalDateTime.ToString("dd/MM HH:mm")</span></div>
                    <h3>@project.Name</h3>
                    <p>@project.Description</p>
                    <div class="project-meta"><span>@project.Mods.Count(mod => mod.Enabled) mods</span><span>PZ @project.TargetPzVersion</span><span>Workshop : @(project.PublishedWorkshopId == 0 ? "à créer" : project.PublishedWorkshopId)</span></div>
                </a>
                <div class="project-card-actions">
                    <details class="project-export-menu">
                        <summary class="button secondary">Exporter</summary>
                        <div class="project-export-options">
                            <form method="post" asp-page-handler="ExportPack" data-file-download data-loading-title="Export de la configuration…" data-loading-detail="Création d’une archive légère sans les mods ni le build. Les sources devront être téléchargées après import." data-loading-steps="Copie de la configuration|Ajout des preuves et assets|Création de l’archive|Téléchargement"><input type="hidden" name="id" value="@project.Id" /><input type="hidden" name="contentMode" value="ConfigurationOnly" /><input type="hidden" name="downloadToken" value="" data-download-token /><button class="button primary" type="submit"><strong>Configuration légère</strong><small>Recommandé · téléchargement requis à l’import</small></button></form>
                            <form method="post" asp-page-handler="ExportPack" data-file-download data-loading-title="Export du pack complet…" data-loading-detail="Calcul des SHA-256, déduplication des snapshots et du build, puis création de l’archive portable." data-loading-steps="Inventaire complet|Calcul SHA-256|Déduplication des blobs|Création de l’archive|Téléchargement"><input type="hidden" name="id" value="@project.Id" /><input type="hidden" name="contentMode" value="Complete" /><input type="hidden" name="downloadToken" value="" data-download-token /><button class="button secondary" type="submit"><strong>Archive complète</strong><small>Versions figées et build inclus</small></button></form>
                        </div>
                    </details>
                    <form method="post" asp-page-handler="Duplicate" data-loading-title="Duplication du pack…" data-loading-detail="Copie de la configuration et création de snapshots indépendants."><input type="hidden" name="id" value="@project.Id" /><button class="button ghost" type="submit">Dupliquer</button></form>
                    <form method="post" asp-page-handler="Delete" data-loading-title="Suppression du projet…" data-loading-detail="Suppression des données locales du projet sans modifier le Workshop ni les mods originaux." data-confirm-title="Supprimer ce projet ?" data-confirm-message="Le projet, ses snapshots et ses builds locaux seront supprimés. Le Workshop publié et les mods originaux ne seront pas modifiés." data-confirm-action="Supprimer le projet" data-confirm-tone="danger"><input type="hidden" name="id" value="@project.Id" /><button class="button danger" type="submit">Supprimer</button></form>
                </div>
            </article>
        }
    </div>
}
