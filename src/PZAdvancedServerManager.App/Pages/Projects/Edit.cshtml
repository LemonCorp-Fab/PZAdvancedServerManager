@page "{id:guid}"
@model PZAdvancedServerManager.App.Pages.Projects.EditModel
@using PZAdvancedServerManager.Core.Domain
@using PZAdvancedServerManager.Core.Pz
@{
    ViewData["Title"] = Model.Project.Name;
    var selectedIds = Model.Project.Mods.Select(x => x.ModId).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var normalizedSelectedIds = Model.Project.Mods.Select(x => ModInfoParser.NormalizeDependencyId(x.ModId)).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var enabledMods = Model.Project.Mods.Count(x => x.Enabled);
    var documentedMods = Model.Project.Mods.Count(x => x.Enabled && x.Permission.Status != PermissionStatus.Unknown);
    var pinnedMods = Model.Project.Mods.Count(x => x.Enabled && Directory.Exists(x.PinnedSourceRoot));
    var globallyUpdatedMods = Model.Project.Mods.Count(x => x.Enabled && x.IncludeInGlobalUpdates);
    var updateTargetMods = Model.Project.PortableSourcesRequired ? enabledMods : globallyUpdatedMods;
    var updateExcludedMods = Model.Project.PortableSourcesRequired ? 0 : enabledMods - globallyUpdatedMods;
    var mapConflicts = Model.MapAnalysis.Entries.Sum(x => x.Conflicts.Count) / 2;
    var createsWorkshopItem = Model.Project.PublishedWorkshopId == 0;
    var validationErrors = Model.Validation.Issues.Count(issue => issue.IsError);
    var validationWarnings = Model.Validation.Issues.Count - validationErrors;
    var unresolvedConflicts = Model.ConflictAnalysis.ErrorCount + Model.ConflictAnalysis.WarningCount;
    var safeBatchMods = Model.VerifiedIncompatibleMods.Concat(Model.UnavailableSourceMods).DistinctBy(mod => mod.Id).ToArray();
    var hasSafeBatch = safeBatchMods.Length > 0 || Model.ConflictAnalysis.HasOrderChange;
    var primaryAutoOrderIssue = Model.ConflictAnalysis.AutoFixableOrderIssues.FirstOrDefault();
}

<a class="back-link" asp-page="/Index">← Tableau de bord</a>

@if (TempData["Message"] is string message) { <div class="toast-message">@message</div> }
@if (TempData["Error"] is string error) { <div class="error-message">@error</div> }
@if (Model.Project.PortableSourcesRequired)
{
    <div class="portable-source-banner">
        <span class="portable-source-mark">↓</span>
        <span><strong>Sources Workshop à télécharger</strong><small>Cette configuration légère ne contient pas les fichiers des mods. « Mettre à jour les mods » téléchargera tous les mods actifs, y compris ceux normalement exclus des mises à jour globales, puis rétablira leurs snapshots figés.</small></span>
    </div>
}

<section class="project-hero workspace-hero">
    <div class="workspace-title">
        <span class="eyebrow">PACK @Model.Project.StableSuffix</span>
        <h1>@Model.Project.Name</h1>
        <p>@(Model.Project.PublishedWorkshopId == 0 ? "Nouvel item Workshop — l’identifiant sera mémorisé après la première publication." : $"Workshop ID {Model.Project.PublishedWorkshopId}")</p>
        <div class="project-kpis">
            <span><strong>@enabledMods</strong> mods</span>
            <span><strong>@Model.MapAnalysis.Entries.Count</strong> cartes</span>
            <span><strong>@pinnedMods/@enabledMods</strong> figés</span>
            <span class="@(mapConflicts > 0 ? "kpi-warning" : "")"><strong>@mapConflicts</strong> conflits de cellules</span>
        </div>
    </div>
    <div class="primary-command-center">
        <div class="primary-command-heading"><span class="eyebrow">COMMANDES PRINCIPALES</span><span>@(Model.Project.PortableSourcesRequired ? $"Réhydratation requise pour {enabledMods} mods actifs" : $"{globallyUpdatedMods}/{enabledMods} mods suivis par la mise à jour globale")</span></div>
        <div class="primary-command-grid">
            <form method="post" asp-page-handler="Build" data-loading-title="Construction du pack…" data-loading-detail="Assemblage des snapshots figés, calcul des hashes et génération des fichiers Workshop." data-loading-steps="Validation des dépendances|Vérification des snapshots|Copie atomique des fichiers|Génération du manifeste Workshop"><button class="primary-command build-command" type="submit"><span class="primary-command-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-hammer"></use></svg></span><span><strong>Construire</strong><small>Générer le pack depuis les versions figées</small></span></button></form>
            <form method="post" asp-page-handler="RefreshSources" data-operation-progress data-loading-title="Mise à jour des mods…" data-loading-detail="SteamCMD télécharge les versions actuelles des mods autorisés, puis remplace uniquement leurs snapshots." data-loading-steps="Préparation des sources|Téléchargement SteamCMD|Inspection des mod.info|Remplacement des snapshots|Enregistrement" data-confirm-title="Mettre à jour les mods ?" data-confirm-message="@(Model.Project.PortableSourcesRequired ? "Cette configuration importée ne contient aucun fichier de mod. Tous les mods actifs seront téléchargés depuis le Workshop et figés localement, y compris ceux normalement exclus des mises à jour globales. Aucun publish ne sera effectué." : "Les snapshots des mods marqués « Mise à jour globale » seront remplacés. Les mods exclus resteront strictement inchangés et aucun publish ne sera effectué.")" data-confirm-action="Mettre à jour les mods"><button class="primary-command update-command" type="submit"><span class="primary-command-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-refresh"></use></svg></span><span><strong>@(Model.Project.PortableSourcesRequired ? "Télécharger les mods requis" : "Mettre à jour les mods")</strong><small>@updateTargetMods sélectionné(s), @updateExcludedMods exclu(s)</small></span></button></form>
            <form id="publish-form" method="post" asp-page-handler="Publish" data-operation-progress data-loading-title="Publication Steam Workshop…" data-loading-detail="Prévalidation des limites, calcul du manifeste, envoi différentiel Steam et coordination post-publication éventuelle." data-loading-steps="Validation et construction|Prévalidation des limites Steam|Inventaire des fichiers|Calcul du manifeste et du delta|Upload des chunks et de la preview|Commit Workshop et confirmation|Contrôle du contenu téléchargé|Délai de sécurité (minimum 5 min)|Coordination du serveur|Finalisation" data-loading-phase-map="build:0,remote-check:1,publish-plan:1,server-preflight:1,publish:1,prevalidation:1,steamcmd:2,manifest-scan:2,manifest-hash:3,manifest-delta:3,workshop-upload:4,workshop-commit:5,remote-confirmed:5,remote-confirmation:5,workshopid:5,published-content-download:6,published-content-integrity:6,published-content-propagation:6,restart-delay:7,server:8,finalize:9" data-confirm-title="@(createsWorkshopItem ? "Créer le nouvel item Workshop ?" : "Mettre à jour l’item Workshop ?")" data-confirm-message="@(createsWorkshopItem ? "Steam créera un nouvel item Workshop, lui attribuera un ID, puis le manager synchronisera automatiquement les manifestes injectés avec ce nouvel ID." : $"L’item Workshop {Model.Project.PublishedWorkshopId} sera mis à jour uniquement si les empreintes locales ou l’état distant ont changé. Le serveur restera actif pendant tout l’upload et ne sera redémarré qu’après confirmation et délai de propagation.")" data-confirm-action="@(createsWorkshopItem ? "Créer et publier" : "Mettre à jour maintenant")" data-confirm-tone="publish"><button class="primary-command publish-command @(!Model.Validation.CanPublish ? "needs-configuration" : string.Empty)" type="submit"><span class="primary-command-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-upload"></use></svg></span><span><strong>@(createsWorkshopItem ? "Créer et publier" : "Publier la mise à jour")</strong><small>@(createsWorkshopItem ? "Steam attribuera et mémorisera le nouvel ID" : $"Différentiel vérifié · Workshop {Model.Project.PublishedWorkshopId}")</small></span></button></form>
            <form class="package-folder-command" method="post" asp-page-handler="OpenBuildFolder" data-loading-title="Ouverture du dossier du package…" data-loading-detail="Lancement du gestionnaire de fichiers sur le build prêt à publier manuellement."><button class="primary-command folder-command" type="submit"><span class="primary-command-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-folder"></use></svg></span><span><strong>Ouvrir le dossier du package</strong><small>Accéder à Contents, steamcmd-item.vdf, preview.png et aux manifestes</small></span></button></form>
        </div>
    </div>
</section>

<a class="project-health-card @((validationErrors > 0 || Model.ConflictAnalysis.ErrorCount > 0) ? "has-errors" : unresolvedConflicts > 0 || validationWarnings > 0 ? "has-warnings" : "is-ready")" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" data-open-project-tab="compatibility">
    <span class="project-health-mark">@((validationErrors > 0 || Model.ConflictAnalysis.ErrorCount > 0) ? "!" : unresolvedConflicts > 0 || validationWarnings > 0 ? "△" : "✓")</span>
    <span class="project-health-copy">
        <span class="eyebrow">ÉTAT DU PACK</span>
        <strong>@(validationErrors > 0 || Model.ConflictAnalysis.ErrorCount > 0 ? "Des corrections sont nécessaires" : unresolvedConflicts > 0 || validationWarnings > 0 ? "Le pack demande votre arbitrage" : "Le pack est cohérent")</strong>
        <small>Build @(Model.Validation.CanBuild ? "prêt" : "bloqué") · Publication @(Model.Validation.CanPublish ? "prête" : "bloquée") · @Model.ConflictAnalysis.ErrorCount conflit(s) bloquant(s) · @Model.ConflictAnalysis.WarningCount alerte(s)</small>
    </span>
    <span class="project-health-action"><strong>Ouvrir le diagnostic</strong><small>Corrections automatiques et décisions manuelles</small></span>
    <span class="project-health-arrow">→</span>
</a>

<form id="install-steamcmd-form" method="post" asp-page-handler="InstallSteamCmd" data-operation-progress data-loading-title="Installation de SteamCMD…" data-loading-detail="Téléchargement depuis Valve, extraction dans l’espace portable du gestionnaire et première initialisation." data-loading-steps="Téléchargement officiel|Extraction contrôlée|Initialisation Steam|Vérification finale" data-loading-phase-map="steamcmd-missing:0,steamcmd-download:0,steamcmd-extract:1,steamcmd-bootstrap:2,steamcmd-ready:3"></form>

<div class="workspace" data-tabs="project-editor">
    <nav class="workspace-tabs" aria-label="Sections du pack" role="tablist">
        <button type="button" role="tab" data-tab-target="overview">Vue d’ensemble</button>
        <button type="button" role="tab" data-tab-target="mods">Mods & droits <span>@enabledMods</span></button>
        <button type="button" role="tab" data-tab-target="compatibility">Compatibilité <span>@unresolvedConflicts</span></button>
        <button type="button" role="tab" data-tab-target="maps">Cartes <span>@Model.MapAnalysis.Entries.Count</span></button>
        <button type="button" role="tab" data-tab-target="distribution">Distribution</button>
        <button type="button" role="tab" data-tab-target="automation">Planification</button>
        <button type="button" role="tab" data-tab-target="expert">Expert</button>
    </nav>

    <form method="post" asp-page-handler="Save" enctype="multipart/form-data" class="workspace-form" data-loading-title="Enregistrement du projet…" data-loading-detail="Mise à jour de la configuration, de l’ordre des cartes, de la preview et des paramètres de publication.">
        <section class="workspace-panel" data-tab-panel="overview" role="tabpanel">
            <div class="panel-heading">
                <div><span class="eyebrow">ESSENTIEL</span><h2>Identité et comportement du pack</h2><p>Les réglages les plus fréquents, sans exposer les détails techniques.</p></div>
            </div>
            <div class="form-section-grid">
                <section class="setting-card wide">
                    <div class="setting-heading"><span class="step-number">01</span><div><h3>Présentation</h3><p>Ce que les joueurs verront sur le Workshop et à la connexion.</p></div></div>
                    <div class="form-grid two">
                        <label><span>Nom du pack</span><input asp-for="Form.Name" /></label>
                        <label class="full"><span>Description publique</span><textarea asp-for="Form.Description" rows="5" placeholder="Présentez le serveur, son ambiance et le rôle du pack…"></textarea></label>
                    </div>
                </section>

                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">02</span><div><h3>Mode de packaging</h3><p>Bundle est le mode fiable pour conserver les Mod IDs.</p></div></div>
                    <div class="choice-grid">
                        <label class="choice-card"><input asp-for="Form.Mode" type="radio" value="@PackageMode.Bundle" /><span><strong>Bundle</strong><small>Plusieurs mods internes, un seul Workshop ID. Recommandé.</small></span></label>
                        <label class="choice-card danger-choice"><input asp-for="Form.Mode" type="radio" value="@PackageMode.FusionStrict" /><span><strong>Fusion stricte</strong><small>Un seul Mod ID, avec blocage immédiat des collisions non identiques.</small></span></label>
                    </div>
                </section>

                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">03</span><div><h3>Fenêtre à la connexion</h3><p>Informe clairement les joueurs du contenu installé.</p></div></div>
                    <label class="switch-row"><input asp-for="Form.InjectConnectionNotice" /><span><strong>Afficher la fenêtre PZASM</strong><small>Votre description, l’avertissement de droits et la liste exhaustive des mods.</small></span></label>
                    <label><span>Titre affiché</span><input asp-for="Form.NoticeTitle" /></label>
                    <label class="switch-row"><input asp-for="Form.InjectInGameControl" /><span><strong>Injecter PZASM Control</strong><small>Bouton PZ permanent et raccourci F8 : états réels, versions, Workshop/Mod IDs et outils réservés aux admins.</small></span></label>
                </section>

                <section class="setting-card wide legal-check">
                    <div class="setting-heading"><span class="step-number">04</span><div><h3>Droits et responsabilité</h3><p>@documentedMods/@enabledMods sources possèdent actuellement un statut documenté.</p></div></div>
                    <label class="switch-row"><input asp-for="Form.LegalWarningAccepted" /><span><strong>J’ai lu l’avertissement sur les autorisations</strong><small>Accusé de lecture facultatif et non bloquant. Le programme et LemonCorp ne sont pas responsables de la redistribution effectuée ; l’administrateur gère librement ses autorisations.</small></span></label>
                    <p class="fine-print">Consultez la <a href="https://projectzomboid.com/blog/modding-policy/" target="_blank" rel="noreferrer">politique officielle de modding</a> et l’<a href="https://steamcommunity.com/workshop/workshopsubmitinfo/" target="_blank" rel="noreferrer">accord légal du Workshop</a>.</p>
                </section>
            </div>
        </section>

        <section class="workspace-panel" data-tab-panel="maps" role="tabpanel">
            <div class="panel-heading">
                <div><span class="eyebrow">PRIORITÉ DES CARTES</span><h2>Ordre intelligent et conflits réels</h2><p>Les cartes en haut gagnent les cellules qui se chevauchent. L’analyse utilise les fichiers <code>map.info</code>, <code>lots=</code> et <code>*.lotheader</code> présents dans les snapshots.</p></div>
                <div class="action-row"><button class="button primary" type="button" data-map-apply-recommended>Appliquer l’ordre conseillé</button><button class="button ghost" type="button" data-map-vanilla-last>Vanilla en dernier</button></div>
            </div>

            @if (Model.MapAnalysis.Entries.Count == 1 && Model.MapAnalysis.Entries[0].IsVanilla)
            {
                <div class="empty-state compact"><h3>Aucune carte de mod détectée</h3><p>Ajoutez un mod contenant <code>media/maps</code>. L’assistant construira alors un ordre recommandé.</p></div>
            }

            <div class="map-order-summary">
                <div><strong>@Model.MapAnalysis.Entries.Count</strong><span>entrées actives</span></div>
                <div class="@(mapConflicts > 0 ? "summary-alert" : "")"><strong>@mapConflicts</strong><span>chevauchements détectés</span></div>
                <div><strong>Haut → bas</strong><span>priorité forte → faible</span></div>
            </div>

            <div class="map-sorter" data-map-sorter>
                @foreach (var entry in Model.MapAnalysis.Entries)
                {
                    <article class="map-order-item @(entry.IsVanilla ? "is-vanilla" : entry.Conflicts.Count > 0 ? "has-conflict" : "")" draggable="true" data-map-item data-map-name="@entry.FolderName" data-recommended-rank="@entry.RecommendedRank">
                        <button class="drag-handle" type="button" title="Glisser pour réordonner" aria-label="Glisser @entry.FolderName">⋮⋮</button>
                        <span class="map-rank" data-map-rank>@(entry.CurrentRank + 1)</span>
                        <div class="map-order-copy">
                            <div class="map-title-row"><strong>@entry.FolderName</strong>@if (entry.IsVanilla) { <span class="priority-badge base">BASE VANILLA</span> } else if (entry.Conflicts.Count > 0) { <span class="priority-badge warning">CONFLIT</span> } else { <span class="priority-badge">COMPATIBLE</span> }</div>
                            <small>@entry.SourceModName@if (!string.IsNullOrWhiteSpace(entry.SourceModId)) { <text> · Mod ID @entry.SourceModId</text> } · @entry.CellCount cellule(s)</small>
                            <p>@entry.Recommendation</p>
                            @if (entry.Conflicts.Count > 0) { <div class="conflict-list">@foreach (var conflict in entry.Conflicts) { <span>@conflict</span> }</div> }
                        </div>
                        <div class="map-order-actions"><button class="icon-button" type="button" data-map-up title="Monter">↑</button><button class="icon-button" type="button" data-map-down title="Descendre">↓</button></div>
                    </article>
                }
            </div>

            <details class="expert-disclosure">
                <summary>Édition brute de <code>Map=</code></summary>
                <label><span>Ordre exact séparé par des points-virgules</span><input asp-for="Form.MapOrder" data-map-raw spellcheck="false" /><small>Les entrées inconnues sont conservées. Utilisez ce champ uniquement si un auteur de carte fournit un ordre spécifique.</small></label>
            </details>
        </section>

        <section class="workspace-panel" data-tab-panel="distribution" role="tabpanel">
            <div class="panel-heading"><div><span class="eyebrow">STEAM WORKSHOP</span><h2>Distribution et publication</h2><p>Les téléchargements de sources et la publication utilisent des identités distinctes.</p></div></div>
            <div class="form-section-grid">
                <section class="setting-card wide steamcmd-card @(Model.SteamCmdStatus.Installed ? "is-ready" : "needs-setup")">
                    <div class="tool-status">
                        <span class="tool-icon">SC</span>
                        <div><span class="eyebrow">OUTIL PORTABLE GÉRÉ</span><h3>@(Model.SteamCmdStatus.Installed ? "SteamCMD est prêt" : "SteamCMD sera installé automatiquement")</h3><p>@(Model.SteamCmdStatus.Installed ? Model.SteamCmdStatus.ExecutablePath : "Au premier import, update ou publish, le manager téléchargera l’archive officielle de Valve dans son propre dossier. Vous pouvez aussi le préparer maintenant.")</p></div>
                        <button class="button @(Model.SteamCmdStatus.Installed ? "ghost" : "primary")" type="submit" form="install-steamcmd-form">@(Model.SteamCmdStatus.Installed ? "Réinstaller / vérifier" : "Installer maintenant")</button>
                    </div>
                </section>

                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">01</span><div><h3>Sources Workshop</h3><p>Les serveurs peuvent télécharger les contenus publics sans compte.</p></div></div>
                    <label class="switch-row"><input asp-for="Form.AnonymousWorkshopDownloads" /><span><strong>Utiliser la connexion anonyme</strong><small>Recommandé pour importer et actualiser les sources. En cas de restriction d’un item, désactivez cette option pour utiliser le compte éditeur.</small></span></label>
                    <label><span>Chemin SteamCMD personnalisé (optionnel)</span><input asp-for="Form.SteamCmdPath" placeholder="Laisser vide pour l’installation portable gérée" /><small>Un chemin existant reste prioritaire. S’il devient invalide, le manager rebascule automatiquement vers sa copie portable.</small></label>
                </section>

                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">02</span><div><h3>Compte de publication dédié</h3><p>Obligatoire uniquement pour créer ou mettre à jour votre item.</p></div></div>
                    <div class="warning-callout publisher-account-warning"><strong>Compte Steam séparé recommandé</strong><p>SteamCMD ouvre une seconde session Steam. Utiliser le compte déjà actif dans le client de bureau peut perturber sa connexion ou votre jeu. Utilisez un compte dédié qui possède Project Zomboid et conservez-le comme propriétaire de l’item Workshop.</p></div>
                    <label><span>Nom du compte Steam éditeur</span><input asp-for="Form.SteamUsername" autocomplete="username" /><small>Le mot de passe et les codes Steam Guard ne sont jamais stockés par PZASM.</small></label>
                    <div class="steam-session-fields">
                        <label><span>Mot de passe temporaire</span><input name="steamPassword" type="password" autocomplete="current-password" data-steam-password /><small>Utilisé uniquement pour créer ou renouveler la session portable, puis oublié. Si Steam Guard est actif, l’approbation dans Steam Mobile est proposée avant le code de secours.</small></label>
                        <input name="steamGuardCode" type="hidden" data-steam-guard-code />
                    </div>
                    <div class="steam-session-status @(Model.Project.Automation.SteamSessionVerifiedAt is null ? "needs-login" : "is-ready")">
                        <span class="status-dot" aria-hidden="true"></span>
                        <div><strong>@(Model.Project.Automation.SteamSessionVerifiedAt is null ? "Session non vérifiée" : "Session portable vérifiée")</strong><small>@(Model.Project.Automation.SteamSessionVerifiedAt is null ? "Connectez ce compte une première fois avant de publier ou d’activer le service." : $"Dernière vérification : {Model.Project.Automation.SteamSessionVerifiedAt.Value.ToLocalTime():dd/MM/yyyy HH:mm}. SteamCMD conserve son propre jeton dans son dossier portable.")</small></div>
                    </div>
                    <div class="steam-session-actions">
                        <button class="button secondary" type="submit" formaction="?handler=VerifySteamSession" data-operation-progress data-loading-title="Vérification de la session SteamCMD…" data-loading-detail="SteamCMD teste uniquement le jeton portable existant, sans mot de passe et sans créer de nouveau jeton." data-loading-steps="Démarrage de SteamCMD|Lecture de la session existante|Vérification du compte|Enregistrement du statut">Vérifier la session existante</button>
                        <button class="button primary" type="submit" formaction="?handler=AuthenticateSteam" data-operation-progress data-loading-title="Création de la session SteamCMD…" data-loading-detail="À utiliser uniquement lors de la première connexion ou après expiration. SteamCMD crée sa session portable; Steam Mobile ou le code de secours peut être demandé." data-loading-steps="Démarrage de SteamCMD|Envoi sécurisé des identifiants|Approbation Steam Guard|Enregistrement de la session portable">Créer / remplacer la session</button>
                    </div>
                    <div class="info-callout"><strong>Aucun renouvellement inutile</strong><p>Les publications manuelles et programmées réutilisent le jeton conservé par SteamCMD. Utilisez d’abord « Vérifier la session existante » ; ne saisissez à nouveau le mot de passe que si Steam réclame une reconnexion.</p></div>
                    <details class="expert-disclosure steam-auth-explanation">
                        <summary>Pourquoi ne pas utiliser « Se connecter avec Steam » ?</summary>
                        <p>Valve prévoit un mode application via Steamworks et ISteamUGC, mais l’éditeur de Project Zomboid doit autoriser l’AppID de l’outil dans les permissions de publication de son Workshop. Sans cette coopération, une application externe ne peut pas s’octroyer ce droit ; SteamCMD reste le fournisseur de publication disponible.</p>
                    </details>
                </section>

                <section class="setting-card wide workshop-preview-editor">
                    <div class="setting-heading"><span class="step-number">03</span><div><h3>Fiche Workshop</h3><p>Contrôlez l’identifiant, la visibilité, les tags et l’image.</p></div></div>
                    <div class="preview-editor-layout">
                        <div class="preview-editor-frame">
                            @if (Model.PreviewAvailable) { <img src="?handler=Preview&id=@Model.Project.Id&v=@Model.Project.LastBuiltAt?.UtcTicks" alt="Preview Workshop actuelle" /> }
                            else { <div class="preview-placeholder"><span>PZ</span><strong>GENERATED PACK</strong><small>Créée au prochain build</small></div> }
                            <span class="preview-source-badge">@Model.PreviewSourceLabel</span>
                        </div>
                        <div class="form-grid">
                            <div class="form-grid two">
                                <label><span>Workshop ID existant</span><input asp-for="Form.PublishedWorkshopId" /><small>0 crée un nouvel item; l’identifiant renvoyé sera conservé.</small></label>
                                <label><span>Visibilité</span><select asp-for="Form.Visibility" asp-items="Html.GetEnumSelectList<WorkshopVisibility>()"></select></label>
                            </div>
                            <label><span>Tags</span><input asp-for="Form.Tags" placeholder="Mod, Build 42" /></label>
                            <label class="preview-file-picker"><span>Votre preview — facultative</span><input asp-for="PreviewUpload" type="file" accept=".png,.jpg,.jpeg,.gif,image/png,image/jpeg,image/gif" /><small>PNG, JPEG ou GIF valide, strictement inférieur à 1 Mo. Sans image, le manager injecte automatiquement la preview de marque affichée ici.</small></label>
                            @if (!string.IsNullOrWhiteSpace(Model.Project.PreviewImagePath)) { <label class="switch-row compact-switch"><input asp-for="Form.ClearPreviewImage" /><span><strong>Revenir à la preview générée</strong><small>L’image personnalisée ne sera plus utilisée au prochain build.</small></span></label> }
                            <details class="expert-disclosure"><summary>Chemin d’image manuel</summary><label><span>Chemin local expert</span><input asp-for="Form.PreviewImagePath" placeholder="C:\…\preview.png" /><small>Le sélecteur de fichier ci-dessus est recommandé. Ce chemin reste disponible pour l’automatisation avancée.</small></label></details>
                        </div>
                    </div>
                </section>

                <section class="setting-card wide">
                    <div class="panel-heading"><div><span class="eyebrow">APERÇU PUBLIC</span><h3>Description Workshop générée</h3></div><div class="inline-actions"><span class="count-pill">@enabledMods sources</span><span class="count-pill">@Model.WorkshopDescriptionUtf8Bytes / 8 000 octets</span>@if (Model.WorkshopDescriptionIsCompact) { <span class="status-pill warning">Mode compact exhaustif</span> }</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.WorkshopDescriptionError))
                    {
                        <div class="warning-callout"><strong>Description trop volumineuse — publication bloquée</strong><p>@Model.WorkshopDescriptionError Le projet, ses mods et ses snapshots restent accessibles et modifiables.</p></div>
                    }
                    <pre class="description-preview">@Model.WorkshopDescription</pre>
                </section>

                <section class="setting-card wide publication-integrity-card">
                    <div class="setting-heading"><span class="step-number">04</span><div><h3>Publication incrémentale vérifiée</h3><p>Un no-change est accepté uniquement si les trois empreintes locales et le manifeste distant relu chez Steam correspondent à la dernière publication confirmée.</p></div></div>
                    <div class="publication-state-grid">
                        <div><span>Contenu</span><strong>@(string.IsNullOrWhiteSpace(Model.Project.Publication.ContentFingerprint) ? "Non publié" : "Empreinte enregistrée")</strong></div>
                        <div><span>Manifest distant</span><strong>@(Model.Project.Publication.RemoteVerifiedAt is null ? "À revérifier" : "Vérifié")</strong></div>
                        <div><span>Dernière preuve</span><strong>@(Model.Project.Publication.RemoteVerifiedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Aucune")</strong></div>
                    </div>
                    <div class="info-callout"><strong>Mode conservateur</strong><p>Si l'API Steam ne permet pas de prouver l'égalité distante, le manager publie. Il ne déclare jamais « aucun changement » sur la seule base du cache local.</p></div>
                    <button class="button danger-outline" type="submit" formaction="?handler=ForcePublish" data-operation-progress data-loading-title="Republication Workshop forcée…" data-loading-detail="SteamCMD recevra le contenu complet, les métadonnées et la preview; Steam réutilisera ensuite ses chunks existants." data-loading-steps="Validation et construction|Prévalidation des limites Steam|Inventaire des fichiers|Calcul du manifeste et du delta|Upload des chunks et de la preview|Commit Workshop et confirmation|Contrôle du contenu téléchargé|Délai de sécurité (minimum 5 min)|Coordination du serveur|Finalisation" data-loading-phase-map="build:0,remote-check:1,publish-plan:1,server-preflight:1,publish:1,prevalidation:1,steamcmd:2,manifest-scan:2,manifest-hash:3,manifest-delta:3,workshop-upload:4,workshop-commit:5,remote-confirmed:5,remote-confirmation:5,workshopid:5,published-content-download:6,published-content-integrity:6,published-content-propagation:6,restart-delay:7,server:8,finalize:9" data-confirm-title="Forcer la republication complète ?" data-confirm-message="Cette action contourne volontairement le no-change local. SteamCMD rescannera le package complet, mais Steam ne retransmettra que les chunks réellement absents. Le serveur restera actif pendant l'upload." data-confirm-action="Forcer la republication" data-confirm-tone="danger">Forcer la republication</button>
                </section>
            </div>
        </section>

        <section class="workspace-panel" data-tab-panel="automation" role="tabpanel">
            <div class="panel-heading"><div><span class="eyebrow">AUTOMATISATION CONTRÔLÉE</span><h2>Fenêtres de maintenance</h2><p>La planification reste désactivée tant que vous ne l’activez pas explicitement.</p></div></div>
            <div class="form-section-grid">
                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">01</span><div><h3>Horaires</h3><p>Une ou plusieurs heures locales au format HH:mm.</p></div></div>
                    <label><span>Heures quotidiennes</span><input asp-for="Form.DailyTimes" placeholder="04:00, 16:00" /></label>
                    <label class="switch-row"><input asp-for="Form.AutomationEnabled" /><span><strong>Activer la planification</strong><small>Le service doit rester lancé pour exécuter les horaires.</small></span></label>
                </section>
                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">02</span><div><h3>Serveur coordonné facultatif</h3><p>Les profils locaux, distants RCON-only et distants avec SSH sont acceptés.</p></div></div>
                    <label><span>Profil serveur coordonné — local ou distant, optionnel</span><input asp-for="Form.CoordinatedServerName" list="server-config-names" placeholder="Aucun processus Project Zomboid coordonné" /></label>
                    <label><span>Délai après confirmation Workshop</span><input asp-for="Form.PostPublishRestartDelayMinutes" type="number" min="5" max="60" /><small>5 minutes minimum. Le serveur reste actif pendant l'upload et durant ce délai, puis reçoit save/quit.</small></label>
                    <label class="switch-row"><input asp-for="Form.VerifyPublishedContentAfterUpload" /><span><strong>Vérifier le contenu publié</strong><small>Retélécharge le pack avec SteamCMD puis contrôle exactement chemins, casse, tailles et SHA-256 avant toute coordination serveur. Le cache rend les contrôles suivants incrémentaux.</small></span></label>
                    <datalist id="server-config-names">@foreach (var serverName in Model.ServerConfigNames) { <option value="@serverName"></option> }</datalist>
                    <div class="info-callout"><strong>Coordination après publication uniquement</strong><p>Tous les profils restent actifs pendant la préparation et l'envoi Workshop. Après confirmation et expiration du délai, le manager envoie save/quit puis lance la stratégie de redémarrage configurée.</p></div>
                </section>
                <section class="setting-card wide">
                    <div class="setting-heading"><span class="step-number">03</span><div><h3>Pipeline programmé</h3><p>Choisissez précisément ce qui se produit pendant la fenêtre.</p></div></div>
                    <div class="choice-grid three">
                        <label class="switch-row"><input asp-for="Form.RefreshSources" /><span><strong>Actualiser</strong><small>Télécharger les sources Workshop avant le build.</small></span></label>
                        <label class="switch-row"><input asp-for="Form.PublishAfterBuild" /><span><strong>Publier</strong><small>Mettre à jour le même item après validation.</small></span></label>
                        <div class="info-callout"><strong>Coordination conditionnelle</strong><p>Aucun arrêt avant publication. Si le contenu a réellement changé, save/quit intervient après confirmation Steam et délai de propagation. Un no-change ou une modification de fiche seule ne redémarre rien.</p></div>
                    </div>
                </section>
            </div>
        </section>

        <section class="workspace-panel" data-tab-panel="expert" role="tabpanel">
            <div class="panel-heading"><div><span class="eyebrow">VALEURS EXACTES</span><h2>Mode expert</h2><p>Ces champs restent disponibles pour les versions et environnements particuliers.</p></div></div>
            <div class="form-section-grid">
                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">01</span><div><h3>Compatibilité</h3><p>Sélection des dossiers versionnés présents dans les mods.</p></div></div>
                    <label><span>Version PZ cible</span><input asp-for="Form.TargetPzVersion" /><small>Exemple : 42.20.2. Le sélecteur choisit le dossier compatible le plus récent sans dépasser cette version.</small></label>
                </section>
                <section class="setting-card">
                    <div class="setting-heading"><span class="step-number">02</span><div><h3>Identifiants stables</h3><p>Valeurs en lecture seule utilisées dans les builds.</p></div></div>
                    <dl class="technical-values"><dt>Suffixe</dt><dd>@Model.Project.StableSuffix</dd><dt>Notice Mod ID</dt><dd>@Model.Project.NoticeModId</dd><dt>Control Mod ID</dt><dd>@Model.Project.ControlModId</dd><dt>Fusion Mod ID</dt><dd>@Model.Project.FusionModId</dd></dl>
                </section>
                <section class="setting-card wide">
                    <div class="warning-callout"><strong>Les snapshots restent la source du build</strong><p>Changer un chemin ici ne modifie jamais les sources Steam. Utilisez l’actualisation explicite pour remplacer les versions figées.</p></div>
                    <dl class="technical-values"><dt>Projet</dt><dd>@Model.Project.Id</dd><dt>Créé</dt><dd>@Model.Project.CreatedAt.LocalDateTime</dd><dt>Dernier build</dt><dd>@(Model.Project.LastBuiltAt?.LocalDateTime.ToString() ?? "Jamais")</dd><dt>Dernière publication</dt><dd>@(Model.Project.LastPublishedAt?.LocalDateTime.ToString() ?? "Jamais")</dd></dl>
                </section>
            </div>
        </section>

        <div class="workspace-savebar"><span><strong>Modifications du pack</strong><small>L’identifiant stable et le Workshop ID existant sont conservés.</small></span><button class="button primary" type="submit">Enregistrer les réglages</button></div>
    </form>

    <section class="workspace-panel compatibility-panel" data-tab-panel="compatibility" role="tabpanel">
        <div class="panel-heading">
            <div><span class="eyebrow">CENTRE DE RÉSOLUTION</span><h2>Compatibilité et décisions du pack</h2><p>Commencez par les corrections certaines, puis examinez uniquement les conflits qui nécessitent réellement votre décision.</p></div>
            <div class="action-row"><a class="button ghost" asp-page="/Projects/Edit" asp-route-id="@Model.Project.Id" asp-route-refresh="true" asp-route-tab="compatibility">Relancer l’analyse complète</a></div>
        </div>

        <section class="resolution-command-center">
            <div class="resolution-command-heading">
                <div><span class="eyebrow">RÉSOLUTION AUTOMATIQUE</span><h3>Corriger ce qui est vérifiable, sans masquer les ambiguïtés</h3><p>Ces actions ne suppriment aucun fichier. Les mods exclus gardent leur snapshot et restent réactivables depuis « Mods & droits ».</p></div>
                <span class="resolution-confidence">RÈGLES DÉTERMINISTES</span>
            </div>
            <div class="resolution-batch-grid">
                <article class="resolution-batch-card @(Model.VerifiedIncompatibleMods.Count > 0 ? "needs-action" : "is-complete")">
                    <span class="resolution-batch-icon">42</span>
                    <div><span class="eyebrow">VERSION CIBLE</span><h4>@Model.VerifiedIncompatibleMods.Count mod(s) incompatible(s) vérifié(s)</h4><p>@(Model.VerifiedIncompatibleMods.Count > 0 ? "Aucun manifeste Build 42 valide n’a été trouvé pour ces snapshots. PZ les ignorera réellement au chargement." : "Tous les snapshots actifs exposent une version compatible avec la cible du pack.")</p></div>
                    @if (Model.VerifiedIncompatibleMods.Count > 0)
                    {
                        <div class="resolution-preview"><span>Seront exclus</span><div>@foreach (var mod in Model.VerifiedIncompatibleMods.Take(8)) { <code>@mod.ModId</code> }@if (Model.VerifiedIncompatibleMods.Count > 8) { <code>+@(Model.VerifiedIncompatibleMods.Count - 8)</code> }</div></div>
                        <form method="post" asp-page-handler="ApplyResolutionBatch" data-loading-title="Exclusion des versions incompatibles…" data-loading-detail="Vérification finale des diagnostics Build 42, désactivation réversible et nouvel audit du pack." data-confirm-title="Exclure @Model.VerifiedIncompatibleMods.Count mod(s) incompatibles ?" data-confirm-message="Seuls les mods pour lesquels l’absence de version Build 42 a été prouvée seront désactivés. Aucun snapshot ni fichier source ne sera supprimé." data-confirm-action="Exclure les incompatibles" data-confirm-tone="danger"><input type="hidden" name="recipe" value="verified-incompatible" /><button class="button danger" type="submit">Exclure les @Model.VerifiedIncompatibleMods.Count mods vérifiés</button></form>
                    }
                    else { <span class="resolution-complete-label">✓ Rien à corriger</span> }
                </article>

                <article class="resolution-batch-card @(Model.UnavailableSourceMods.Count > 0 ? "needs-action" : "is-complete")">
                    <span class="resolution-batch-icon">SRC</span>
                    <div><span class="eyebrow">SOURCES</span><h4>@Model.UnavailableSourceMods.Count source(s) inutilisable(s)</h4><p>@(Model.UnavailableSourceMods.Count > 0 ? "Le dossier ou le mod.info effectif est absent. Ces entrées ne peuvent pas produire un mod chargeable." : "Toutes les sources actives et leurs manifestes effectifs sont accessibles.")</p></div>
                    @if (Model.UnavailableSourceMods.Count > 0)
                    {
                        <div class="resolution-preview"><span>Seront exclues</span><div>@foreach (var mod in Model.UnavailableSourceMods.Take(8)) { <code>@mod.ModId</code> }@if (Model.UnavailableSourceMods.Count > 8) { <code>+@(Model.UnavailableSourceMods.Count - 8)</code> }</div></div>
                        <form method="post" asp-page-handler="ApplyResolutionBatch" data-loading-title="Exclusion des sources inutilisables…" data-loading-detail="Nouvelle vérification des chemins et manifestes avant désactivation réversible." data-confirm-title="Exclure @Model.UnavailableSourceMods.Count source(s) inutilisables ?" data-confirm-message="Seules les entrées dont la source ou le mod.info effectif est réellement absent seront désactivées. Les fichiers encore présents ne seront pas modifiés." data-confirm-action="Exclure les sources" data-confirm-tone="danger"><input type="hidden" name="recipe" value="unavailable-sources" /><button class="button danger" type="submit">Exclure les @Model.UnavailableSourceMods.Count sources</button></form>
                    }
                    else { <span class="resolution-complete-label">✓ Rien à corriger</span> }
                </article>

                <article class="resolution-batch-card @(Model.ConflictAnalysis.HasOrderProblem ? "needs-action" : "is-complete") @(Model.ConflictAnalysis.HasUnrepairableOrderCycle ? "is-blocked" : null)">
                    <span class="resolution-batch-icon">↕</span>
                    <div><span class="eyebrow">ORDRE DYNAMIQUE</span><h4>@(Model.ConflictAnalysis.HasUnrepairableOrderCycle ? "Cycle bloquant à examiner" : Model.ConflictAnalysis.HasOrderProblem ? "Un ordre valide doit être restauré" : "Ordre déjà optimisé")</h4><p>Dépendances, <code>loadAfter/loadBefore</code>, décisions de priorité, connecteurs et cellules de cartes sont calculés ensemble.</p></div>
                    @if (primaryAutoOrderIssue is not null)
                    {
                        <form method="post" asp-page-handler="RepairOrderIssue" data-loading-title="Réparation de l’ordre…" data-loading-detail="Validation du graphe, retrait des seules priorités contradictoires et tri topologique complet."><input type="hidden" name="conflictKey" value="@primaryAutoOrderIssue.Key" /><button class="button primary" type="submit">Réparer l’ordre automatiquement</button></form>
                    }
                    else if (Model.ConflictAnalysis.HasUnrepairableOrderCycle)
                    {
                        <a class="button danger-outline" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="errors" asp-route-conflictCategory="Order" asp-fragment="conflict-workbench">Examiner le cycle bloquant</a>
                    }
                    else if (Model.ConflictAnalysis.HasOrderChange)
                    {
                        <form method="post" asp-page-handler="ApplyRecommendedOrder" data-loading-title="Application de l’ordre recommandé…" data-loading-detail="Tri topologique des mods, contraintes mod.info, priorités manuelles et ordre dynamique des cartes." data-confirm-title="Appliquer l’ordre recommandé ?" data-confirm-message="L’ordre des Mod IDs et des cartes sera remplacé par la recommandation calculée. Les choix manuels de gagnant déjà enregistrés seront respectés." data-confirm-action="Appliquer l’ordre"><button class="button primary" type="submit">Optimiser mods + cartes</button></form>
                    }
                    else { <span class="resolution-complete-label">✓ Rien à corriger</span> }
                </article>
            </div>
            @if (hasSafeBatch)
            {
                <div class="resolution-all-safe">
                    <div><strong>Tout ce qui est certain, en une seule passe</strong><span>@safeBatchMods.Length exclusion(s) réversible(s) · ordre des mods et cartes recalculé · aucune collision ambiguë décidée à votre place</span></div>
                    <form method="post" asp-page-handler="ApplyResolutionBatch" data-loading-title="Application des corrections sûres…" data-loading-detail="Nouvelle analyse, exclusions vérifiées, recalcul des dépendances et ordre final des cartes." data-confirm-title="Appliquer toutes les corrections sûres ?" data-confirm-message="@safeBatchMods.Length mod(s) dont l’incompatibilité ou la source inutilisable est prouvée seront désactivés, puis l’ordre complet sera recalculé. Les conflits ambigus resteront à arbitrer et aucun fichier ne sera supprimé." data-confirm-action="Tout corriger automatiquement"><input type="hidden" name="recipe" value="all-safe" /><button class="button primary" type="submit">Tout corriger automatiquement</button></form>
                </div>
            }
        </section>

        @if (Model.Validation.Issues.Count > 0)
        {
            <details class="configuration-diagnostics">
                <summary><span><span class="eyebrow">CONFIGURATION GÉNÉRALE</span><strong>@validationErrors erreur(s) · @validationWarnings avertissement(s)</strong><small>Build, publication et planification — ouvrir pour afficher la liste complète.</small></span><span class="count-pill">@Model.Validation.Issues.Count</span></summary>
                <ul>@foreach (var issue in Model.Validation.Issues) { <li class="@(issue.IsError ? "issue-error" : "")">@issue.Message</li> }</ul>
            </details>
        }

        <section class="conflict-workbench" id="conflict-workbench">
            <div class="conflict-workbench-heading">
                <div><span class="eyebrow">ATELIER DE COMPATIBILITÉ</span><h3>Conflits, dépendances et ordre dynamique</h3><p>Analyse des <code>mod.info</code>, contraintes <code>require/loadAfter/loadBefore/incompatible</code>, versions PZ, chemins Lua/scripts/assets et cellules de cartes.</p></div>
                <div class="conflict-scoreboard">
                    <span class="error @(Model.ConflictAnalysis.ErrorCount > 0 ? "has-errors" : null)"><strong>@Model.ConflictAnalysis.ErrorCount</strong><small>bloquants</small></span>
                    <span class="warning"><strong>@Model.ConflictAnalysis.WarningCount</strong><small>à arbitrer</small></span>
                    <span class="resolved"><strong>@Model.ConflictAnalysis.ResolvedCount</strong><small>résolus</small></span>
                </div>
            </div>
            @if (Model.ConflictAnalysis.ErrorCount > 0)
            {
                <section class="compatibility-critical-banner" role="alert">
                    <span class="compatibility-critical-icon" aria-hidden="true">!</span>
                    <div><span class="eyebrow">PACK BLOQUÉ</span><strong>@Model.ConflictAnalysis.ErrorCount problème(s) critique(s) à corriger avant construction</strong><p>Les erreurs critiques sont ouvertes automatiquement et ne peuvent pas être marquées comme volontairement ignorées.</p></div>
                    <div class="compatibility-critical-actions">
                        @if (primaryAutoOrderIssue is not null)
                        {
                            <form method="post" asp-page-handler="RepairOrderIssue" data-loading-title="Réparation du blocage…" data-loading-detail="Contrôle des dépendances, suppression des seules priorités contradictoires et recalcul de l’ordre."><input type="hidden" name="conflictKey" value="@primaryAutoOrderIssue.Key" /><button class="button primary" type="submit">Corriger le blocage d’ordre</button></form>
                        }
                        <a class="button danger-outline" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="errors" asp-route-conflictCategory="all" asp-route-conflictType="all" asp-fragment="conflict-workbench">Afficher uniquement les bloquants</a>
                    </div>
                </section>
            }
            <div class="conflict-audit-facts">
                <span><strong>@Model.ConflictAnalysis.ScannedFiles.ToString("N0")</strong><small>fichiers effectifs inspectés</small></span>
                <span><strong>@Model.ConflictAnalysis.ComparedFilePaths.ToString("N0")</strong><small>chemins partagés comparés</small></span>
                <span><strong>@Model.ConflictAnalysis.Duration.TotalSeconds.ToString("0.0") s</strong><small>analyse mise en cache</small></span>
                <a class="button secondary" asp-page="/Projects/Edit" asp-route-id="@Model.Project.Id" asp-route-refresh="true" asp-route-tab="compatibility" asp-fragment="conflict-workbench">Rafraîchir les preuves</a>
            </div>
            @if (Model.ConflictAnalysis.TypeSummaries.Count > 0)
            {
                <section class="conflict-type-diagnostic" aria-label="Diagnostic par type de conflit">
                    <div class="conflict-type-heading">
                        <div><span class="eyebrow">DIAGNOSTIC PAR IMPACT</span><h4>Nature et gravité des conflits</h4></div>
                        <a class="@(Model.ConflictType == "all" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="all" asp-route-conflictCategory="all" asp-route-conflictType="all" asp-fragment="conflict-workbench">Afficher tous les types</a>
                    </div>
                    <div class="conflict-type-grid">
                        @foreach (var summary in Model.ConflictAnalysis.TypeSummaries)
                        {
                            var summaryRiskLabel = summary.Risk switch
                            {
                                ModConflictRisk.Low => "Faible",
                                ModConflictRisk.Moderate => "Modéré",
                                ModConflictRisk.High => "Élevé",
                                _ => "Critique"
                            };
                            <a class="conflict-type-card risk-@summary.Risk.ToString().ToLowerInvariant() @(Model.ConflictType == summary.TypeLabel ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="all" asp-route-conflictCategory="all" asp-route-conflictType="@summary.TypeLabel" asp-fragment="conflict-workbench">
                                <span class="conflict-type-card-heading"><strong>@summary.TypeLabel</strong><b>@summary.Total</b></span>
                                <span class="conflict-risk-label">Risque @summaryRiskLabel</span>
                                <small><b>@summary.Errors</b> bloquant(s) · <b>@summary.Warnings</b> alerte(s) · <b>@summary.Information</b> information(s) · <b>@summary.Resolved</b> examiné(s)</small>
                                @if (!string.IsNullOrWhiteSpace(summary.SampleEvidence))
                                {
                                    <code title="@summary.SampleEvidence">@summary.SampleEvidence</code>
                                }
                            </a>
                        }
                    </div>
                </section>
            }
            @if (Model.ConflictAnalysis.Issues.Count > 0)
            {
                <nav class="conflict-filter-bar" aria-label="Compatibility analysis filters">
                    <div class="conflict-filter-group">
                        <span>État</span>
                        <a class="@(Model.ConflictFilter == "action" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="action" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">À traiter <strong>@Model.ConflictAnalysis.Issues.Count(issue => !issue.IsResolved && issue.Severity != ModConflictSeverity.Information)</strong></a>
                        <a class="@(Model.ConflictFilter == "errors" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="errors" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">Bloquants <strong>@Model.ConflictAnalysis.ErrorCount</strong></a>
                        <a class="@(Model.ConflictFilter == "warnings" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="warnings" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">Alertes <strong>@Model.ConflictAnalysis.WarningCount</strong></a>
                        <a class="@(Model.ConflictFilter == "resolved" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="resolved" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">Examinés <strong>@Model.ConflictAnalysis.ResolvedCount</strong></a>
                        <a class="@(Model.ConflictFilter == "all" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="all" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">Tous <strong>@Model.ConflictAnalysis.Issues.Count</strong></a>
                    </div>
                    <div class="conflict-filter-group category">
                        <span>Famille</span>
                        <a class="@(Model.ConflictCategory == "all" ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="all" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">Toutes</a>
                        @foreach (var category in Enum.GetValues<ModConflictCategory>())
                        {
                            <a class="@(Model.ConflictCategory == category.ToString() ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@category" asp-route-conflictType="@Model.ConflictType" asp-fragment="conflict-workbench">@category</a>
                        }
                    </div>
                </nav>
            }
            @if (Model.ConflictAnalysis.Issues.Count == 0)
            {
                <div class="conflict-clean"><span>✓</span><div><strong>Aucun conflit détecté</strong><small>Les contraintes déclarées, les versions et les chemins effectifs sont cohérents.</small></div></div>
            }
            else
            {
                @if (Model.FilteredConflictCount == 0)
                {
                    <div class="conflict-clean"><span>✓</span><div><strong>Aucun résultat pour ces filtres</strong><small>Changez l'état ou la famille pour afficher les autres diagnostics.</small></div></div>
                }
                <div class="conflict-issue-list">
                @{ var visibleConflictIndex = 0; }
                @foreach (var issue in Model.VisibleConflictIssues)
                {
                    var issueIndex = visibleConflictIndex++;
                    var riskLabel = issue.Risk switch
                    {
                        ModConflictRisk.Low => "Faible",
                        ModConflictRisk.Moderate => "Modéré",
                        ModConflictRisk.High => "Élevé",
                        _ => "Critique"
                    };
                    var primaryFileFormId = $"open-conflict-file-{Model.ConflictPage}-{issueIndex}-0";
                    var orderFixFormId = $"repair-order-{Model.ConflictPage}-{issueIndex}";
                    var comparableTextPaths = issue.FileEvidence
                        .Where(file => TextConflictDiffService.IsSupportedPath(file.PhysicalPath)
                            && System.IO.File.Exists(file.PhysicalPath)
                            && new FileInfo(file.PhysicalPath).Length <= TextConflictDiffService.MaximumFileBytes)
                        .GroupBy(file => file.VirtualPath, StringComparer.OrdinalIgnoreCase)
                        .Count(group => group.Select(file => file.ModReferenceId).Distinct().Count() >= 2);
                    var primaryFileEntries = issue.FileEvidence
                        .Select((file, index) => (File: file, Index: index))
                        .Where(entry => entry.File.VirtualPath.Equals(issue.PrimaryEvidence, StringComparison.OrdinalIgnoreCase))
                        .ToArray();
                    <details class="conflict-issue severity-@issue.Severity.ToString().ToLowerInvariant() risk-@issue.Risk.ToString().ToLowerInvariant() @(issue.IsResolved ? "is-resolved" : "")" open="@(issue.Severity == ModConflictSeverity.Error && !issue.IsResolved ? "open" : null)">
                        <summary>
                            <span class="conflict-severity-mark">@(issue.IsResolved ? "✓" : issue.Severity == ModConflictSeverity.Error ? "!" : issue.Severity == ModConflictSeverity.Warning ? "△" : "i")</span>
                            <span class="conflict-summary-copy">
                                <span class="conflict-title-line"><strong>@issue.Title</strong><b>@issue.EffectiveTypeLabel</b></span>
                                @if (!string.IsNullOrWhiteSpace(issue.PrimaryEvidence))
                                {
                                    <span class="conflict-header-proof"><em>PREUVE</em><code title="@issue.PrimaryEvidence">@issue.PrimaryEvidence</code></span>
                                }
                                <small>@issue.Category · @issue.Code@if (issue.IsResolved) { <text> · RÉSOLU</text> }</small>
                            </span>
                            <span class="conflict-summary-actions">
                                @if (issue.Severity == ModConflictSeverity.Error && !issue.IsResolved)
                                {
                                    <span class="conflict-blocking-badge">BLOQUANT</span>
                                }
                                <span class="conflict-risk-badge">Risque @riskLabel</span>
                                <span class="conflict-participant-count">@issue.ModIds.Count mod(s)</span>
                                @if (issue.CanAutoFixOrder)
                                {
                                    <button class="button primary compact conflict-auto-fix-header" type="submit" form="@orderFixFormId" data-summary-action>Corriger automatiquement</button>
                                }
                                @if (issue.Code == "MISSING_DEPENDENCY" && !string.IsNullOrWhiteSpace(issue.MissingDependencyModId))
                                {
                                    <button class="button primary compact" type="submit" form="add-dependency-@Model.ConflictPage-@issueIndex" data-summary-action>Ajouter la dépendance</button>
                                }
                                @if (comparableTextPaths > 0)
                                {
                                    <a class="button primary compact conflict-diff-header" asp-page="/Projects/ConflictDiff" asp-route-id="@Model.Project.Id" asp-route-conflictKey="@issue.Key" data-summary-action>Voir le diff</a>
                                }
                                @if (primaryFileEntries.Length > 0)
                                {
                                    <button class="button secondary compact conflict-open-header" type="submit" form="@primaryFileFormId" data-summary-action>Ouvrir le fichier</button>
                                }
                            </span>
                        </summary>
                        <div class="conflict-issue-body">
                            @if (issue.Severity == ModConflictSeverity.Error && !issue.IsResolved)
                            {
                                <div class="conflict-critical-callout"><span aria-hidden="true">!</span><div><strong>Ce problème bloque un ordre de chargement fiable</strong><small>Corrigez-le avant le prochain build ou la prochaine publication du pack.</small></div></div>
                            }
                            <p>@issue.Detail</p>
                            @if (issue.ModIds.Count > 0)
                            {
                                <div class="conflict-mod-chips">@foreach (var modId in issue.ModIds) { <code>@modId</code> }</div>
                            }
                            @if (issue.Evidence.Count > 0)
                            {
                                <details class="conflict-evidence"><summary>Afficher les preuves (@issue.Evidence.Count)</summary><div>@foreach (var evidence in issue.Evidence) { if (!string.IsNullOrWhiteSpace(evidence)) { <code>@evidence</code> } }</div></details>
                            }
                            @if (primaryFileEntries.Length > 0)
                            {
                                <div class="conflict-file-locations">
                                    <span><strong>Copies physiques du fichier en conflit</strong><small>Ouvrez chaque version pour comparer le contenu exact fourni par les mods.</small></span>
                                    @foreach (var entry in primaryFileEntries)
                                    {
                                        var file = entry.File;
                                        var fileIndex = entry.Index;
                                        var formId = $"open-conflict-file-{Model.ConflictPage}-{issueIndex}-{fileIndex}";
                                        <div class="conflict-file-location">
                                            <span><b>@file.ModId</b><code title="@file.PhysicalPath">@file.PhysicalPath</code></span>
                                            <form id="@formId" method="post" asp-page-handler="OpenConflictFile" data-loading-title="Ouverture de la preuve…" data-loading-detail="Validation du chemin puis ouverture avec l'application associée du système.">
                                                <input type="hidden" name="conflictKey" value="@issue.Key" />
                                                <input type="hidden" name="fileIndex" value="@fileIndex" />
                                                <button class="button ghost compact" type="submit">Ouvrir cette copie</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="conflict-resolution-tools">
                                @if (issue.Code == "MISSING_DEPENDENCY" && !string.IsNullOrWhiteSpace(issue.MissingDependencyModId) && issue.ModReferenceIds.Count > 0)
                                {
                                    <form id="add-dependency-@Model.ConflictPage-@issueIndex" method="post" asp-page-handler="AddMissingDependency" class="conflict-dependency-fix-panel" data-loading-title="Ajout de la dépendance…" data-loading-detail="Recherche locale, vérification des dépendances Workshop officielles, téléchargement, snapshot et recalcul de l’ordre." data-loading-steps="Recherche de la source|Vérification Workshop|Téléchargement|Création du snapshot|Recalcul de l’ordre">
                                        <input type="hidden" name="modReferenceId" value="@issue.ModReferenceIds[0]" />
                                        <input type="hidden" name="requiredModId" value="@issue.MissingDependencyModId" />
                                        <span class="conflict-auto-fix-icon" aria-hidden="true">+</span>
                                        <span><strong>Dépendance ajoutable automatiquement</strong><small><span>Le manager cherchera cette dépendance sur le disque puis dans les dépendances officielles du Workshop.</span> <code>@issue.MissingDependencyModId</code> · <span>La source sera vérifiée avant d’être ajoutée.</span></small></span>
                                        <button class="button primary" type="submit">Ajouter @issue.MissingDependencyModId</button>
                                    </form>
                                }
                                @if (issue.CanAutoFixOrder)
                                {
                                    <form id="@orderFixFormId" method="post" asp-page-handler="RepairOrderIssue" class="conflict-auto-fix-panel" data-loading-title="Réparation de l’ordre…" data-loading-detail="Nouvelle analyse, retrait des seules décisions contradictoires et validation du tri topologique final.">
                                        <input type="hidden" name="conflictKey" value="@issue.Key" />
                                        <span class="conflict-auto-fix-icon" aria-hidden="true">↕</span>
                                        <span><strong>Correction déterministe disponible</strong><small>@(issue.AutomaticOrderFixKeys.Count > 0 ? "La priorité manuelle contradictoire sera retirée, puis l’ordre complet sera recalculé." : "Les mods seront replacés selon leurs dépendances et contraintes déclarées.") Aucun mod ni snapshot ne sera supprimé.</small></span>
                                        <button class="button primary" type="submit">Réparer cet ordre</button>
                                    </form>
                                }
                                @if (issue.CanChooseWinner)
                                {
                                    <div class="conflict-winner-tools"><span><strong>Choisir le contenu prioritaire</strong><small>Le gagnant sera placé après les autres mods de cette collision.</small></span><div class="action-row">
                                    @foreach (var modId in issue.ModIds)
                                    {
                                        <form method="post" asp-page-handler="ResolveConflict" data-loading-title="Calcul de la priorité…" data-loading-detail="Enregistrement du gagnant puis recalcul de l'ordre complet des dépendances." data-confirm-title="Donner la priorité à @modId ?" data-confirm-message="Ce mod sera chargé après les autres participants pour les chemins concernés. Cette décision ne modifie aucun fichier source." data-confirm-action="Donner la priorité"><input type="hidden" name="conflictKey" value="@issue.Key" /><input type="hidden" name="winnerModId" value="@modId" /><button class="button @(issue.SelectedWinnerModId.Equals(modId, StringComparison.OrdinalIgnoreCase) ? "primary" : "secondary") compact" type="submit">@(issue.SelectedWinnerModId.Equals(modId, StringComparison.OrdinalIgnoreCase) ? $"Prioritaire : {modId}" : $"Préférer {modId}")</button></form>
                                    }
                                    </div></div>
                                }
                                <div class="conflict-secondary-tools">
                                    @if (issue.IsResolved || Model.Project.AcknowledgedConflicts.Contains(issue.Key, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <form method="post" asp-page-handler="ClearConflictResolution" data-loading-title="Réouverture du conflit…"><input type="hidden" name="conflictKey" value="@issue.Key" /><button class="button ghost compact" type="submit">Réouvrir / effacer le choix</button></form>
                                    }
                                    else if (issue.Severity != ModConflictSeverity.Error)
                                    {
                                        <form method="post" asp-page-handler="AcknowledgeConflict" data-loading-title="Documentation du conflit…" data-confirm-title="Marquer ce conflit comme volontaire ?" data-confirm-message="Le problème restera visible dans l'audit, mais sera compté comme examiné. Aucun fichier ne sera modifié." data-confirm-action="Marquer comme examiné"><input type="hidden" name="conflictKey" value="@issue.Key" /><button class="button ghost compact" type="submit">Conserver volontairement</button></form>
                                    }
                                    @if (issue.CanDisableMods)
                                    {
                                        @foreach (var modReferenceId in issue.ModReferenceIds)
                                        {
                                            var affectedMod = Model.Project.Mods.FirstOrDefault(mod => mod.Id == modReferenceId);
                                            if (affectedMod is not null)
                                            {
                                                <form method="post" asp-page-handler="SetModEnabled" data-loading-title="Désactivation du mod…" data-confirm-title="Désactiver @affectedMod.Name ?" data-confirm-message="Le mod sera exclu du prochain build et des listes serveur générées. Son snapshot restera disponible pour le réactiver." data-confirm-action="Désactiver du pack" data-confirm-tone="danger"><input type="hidden" name="modReferenceId" value="@affectedMod.Id" /><input type="hidden" name="enabled" value="false" /><button class="button danger compact" type="submit">Désactiver @affectedMod.ModId</button></form>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </details>
                }
                </div>
                @if (Model.ConflictPageCount > 1)
                {
                    var firstConflictPage = Math.Max(1, Model.ConflictPage - 2);
                    var lastConflictPage = Math.Min(Model.ConflictPageCount, firstConflictPage + 4);
                    firstConflictPage = Math.Max(1, lastConflictPage - 4);
                    <nav class="conflict-pager" aria-label="Pages des diagnostics">
                        <span>@Model.FilteredConflictCount diagnostic(s) · @Model.ConflictPageSize par page</span>
                        <div>
                            @if (Model.ConflictPage > 1)
                            {
                                <a asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-route-conflictPage="@(Model.ConflictPage - 1)" asp-fragment="conflict-workbench">Précédent</a>
                            }
                            @for (var conflictPageNumber = firstConflictPage; conflictPageNumber <= lastConflictPage; conflictPageNumber++)
                            {
                                <a class="@(conflictPageNumber == Model.ConflictPage ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-route-conflictPage="@conflictPageNumber" asp-fragment="conflict-workbench">@conflictPageNumber</a>
                            }
                            @if (Model.ConflictPage < Model.ConflictPageCount)
                            {
                                <a asp-route-id="@Model.Project.Id" asp-route-tab="compatibility" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-conflictType="@Model.ConflictType" asp-route-conflictPage="@(Model.ConflictPage + 1)" asp-fragment="conflict-workbench">Suivant</a>
                            }
                        </div>
                    </nav>
                }
            }
        </section>

    </section>

    <section class="workspace-panel" data-tab-panel="mods" role="tabpanel">
        <div class="panel-heading">
            <div><span class="eyebrow">SOURCES FIGÉES</span><h2>Mods, dépendances et autorisations</h2><p>Ajoutez, mettez à jour et documentez les sources. Les problèmes techniques sont regroupés dans l’onglet Compatibilité.</p></div>
            <div class="action-row"><a class="button primary" asp-page="/Workshop/Index" asp-route-projectId="@Model.Project.Id">Ouvrir le catalogue interne</a><a class="button ghost" asp-page="/Projects/Edit" asp-route-id="@Model.Project.Id" asp-route-refresh="true" asp-route-tab="mods">Relancer la détection</a></div>
        </div>

        <section class="catalog-launch-card">
            <span class="catalog-launch-mark">W</span>
            <div><span class="eyebrow">SÉLECTION AVANCÉE</span><h3>Workshop et bibliothèque locale unifiés</h3><p>Recherchez, filtrez et sélectionnez plusieurs items, puis laissez SteamCMD télécharger et analyser tous leurs <code>mod.info</code>.</p></div>
            <div class="action-row"><a class="button primary" asp-page="/Workshop/Index" asp-route-projectId="@Model.Project.Id" asp-route-source="workshop">Explorer le Workshop</a><a class="button secondary" asp-page="/Workshop/Index" asp-route-projectId="@Model.Project.Id" asp-route-source="local">Choisir les mods installés</a></div>
        </section>

        <details class="mod-list-importer" open="@(Model.ModImportPreview is not null)">
            <summary>
                <span class="mod-list-import-icon">INI</span>
                <span><span class="eyebrow">IMPORT ASSISTÉ</span><strong>Charger les mods depuis une configuration</strong><small>Fichier serveur Project Zomboid ou liste de Mod IDs séparés par des points-virgules.</small></span>
                <span class="button secondary mod-list-import-toggle">Importer une liste</span>
            </summary>
            <div class="mod-list-import-body">
                <form method="post" asp-page-handler="PreviewModList" asp-route-tab="mods" enctype="multipart/form-data" class="mod-list-source-form" data-loading-title="Analyse de la liste de mods…" data-loading-detail="Lecture de WorkshopItems et Mods, détection des sources disponibles et préparation de la sélection.">
                    <div class="mod-list-source-grid">
                        <label class="mod-list-file-picker"><span>Fichier de configuration</span><input asp-for="ModListUpload" type="file" accept=".ini,.txt,.cfg,text/plain" /><small>Charge un fichier serveur contenant <code>WorkshopItems=</code> et <code>Mods=</code>. 1 Mio maximum.</small></label>
                        <span class="mod-list-or">OU</span>
                        <label><span>Liste de Mod IDs</span><textarea asp-for="ModListText" rows="4" placeholder="ModIdOne;ModIdTwo;ModIdThree"></textarea><small>Vous pouvez aussi coller directement les lignes <code>WorkshopItems=…</code> et <code>Mods=…</code>.</small></label>
                    </div>
                    <div class="mod-list-source-actions"><span>Cette étape ne modifie pas encore le pack.</span><button class="button primary" type="submit">Analyser et choisir</button></div>
                </form>

                @if (Model.ModImportPreview is { } importPreview)
                {
                    <section class="mod-import-preview" data-mod-import-preview>
                        <div class="mod-import-preview-heading">
                            <div><span class="eyebrow">APERÇU DE L’IMPORT</span><h3>@importPreview.SourceLabel</h3><p>@importPreview.ModIdCount Mod ID(s) · @importPreview.WorkshopIdCount Workshop ID(s) · aucune modification appliquée</p></div>
                            <span class="mod-import-selection-count"><strong data-mod-import-selected>0</strong><small>sélectionnés</small></span>
                        </div>
                        <form id="mod-list-apply-form" method="post" asp-page-handler="ApplyModList" asp-route-tab="mods" data-operation-progress data-loading-title="Ajout de la sélection au pack…" data-loading-detail="Téléchargement des items manquants, résolution des Mod IDs et création des snapshots figés." data-loading-steps="Validation de la sélection|Téléchargement Workshop|Résolution des Mod IDs|Création des snapshots|Enregistrement du pack">
                            <div class="mod-import-toolbar">
                                <label><span class="sr-only">Filtrer les entrées analysées</span><input type="search" data-mod-import-filter placeholder="Filtrer par nom, auteur, Mod ID ou Workshop ID…" autocomplete="off" /></label>
                                <div class="action-row"><button class="button ghost compact" type="button" data-mod-import-select="all">Tout sélectionner</button><button class="button ghost compact" type="button" data-mod-import-select="none">Tout désélectionner</button></div>
                            </div>
                            <div class="mod-import-candidates" data-mod-import-candidates>
                            @foreach (var candidate in importPreview.Candidates)
                            {
                                <label class="mod-import-candidate @candidate.Tone" data-mod-import-row data-mod-import-search="@($"{candidate.Kind} {candidate.Identifier} {candidate.Title} {candidate.Detail} {candidate.Status}".ToLowerInvariant())">
                                    @if (candidate.Selectable)
                                    {
                                        <input type="checkbox" name="selectedEntries" value="@candidate.Value" checked="@candidate.SelectedByDefault" />
                                    }
                                    else
                                    {
                                        <span class="mod-import-state-icon" aria-hidden="true">@(candidate.Tone == "resolved" || candidate.Tone == "existing" ? "✓" : "!")</span>
                                    }
                                    <span class="mod-import-candidate-copy"><span><em>@candidate.Kind</em><code>@candidate.Identifier</code></span><strong>@candidate.Title</strong><small>@candidate.Detail</small></span>
                                    <span class="mod-import-status">@candidate.Status</span>
                                </label>
                            }
                            </div>
                            <div class="mod-import-empty" data-mod-import-empty hidden><strong>Aucune entrée ne correspond au filtre.</strong><span>Effacez la recherche pour retrouver toute la liste analysée.</span></div>
                            <div class="mod-import-applybar"><span><strong>Versions figées après confirmation</strong><small>Les dépendances disponibles seront ajoutées comme lors d’un ajout manuel.</small></span><button class="button primary" type="submit" data-mod-import-submit>Ajouter la sélection au pack</button></div>
                        </form>
                    </section>
                }
            </div>
        </details>

        <div class="mod-add-grid">
            <form method="post" asp-page-handler="ImportWorkshop" class="setting-card add-source-card" data-dependency-preflight-url="@Url.Page(null, "WorkshopDependencyPlan", new { id = Model.Project.Id })" data-loading-title="Import de l’item Workshop…" data-loading-detail="Téléchargement SteamCMD, analyse des mod.info et création des snapshots figés.">
                <span class="eyebrow">PAR WORKSHOP ID</span><h3>Télécharger et figer</h3><p>Importe tous les Mod IDs compatibles contenus dans un item.</p>
                <div class="add-mod-row"><input name="workshopId" type="number" min="1" required placeholder="Workshop ID" /><button class="button secondary" type="submit">Importer</button></div>
            </form>
            <form method="post" asp-page-handler="AddMod" class="setting-card add-source-card" data-dependency-preflight-url="@Url.Page(null, "AddModDependencyPlan", new { id = Model.Project.Id })" data-loading-title="Ajout du mod au pack…" data-loading-detail="Copie de la source dans un snapshot privé et ajout des dépendances disponibles.">
                <span class="eyebrow">DEPUIS LE DISQUE</span><h3>Ajouter une source détectée</h3><p>Sélectionnez un mod local ou déjà téléchargé par Steam.</p>
                <input class="mod-filter" type="search" data-mod-filter placeholder="Filtrer par nom, Mod ID ou Workshop ID…" autocomplete="off" />
                <div class="add-mod-row"><select name="selectionKey" required data-mod-select><option value="">Choisir parmi @Model.InstalledMods.Count mods détectés…</option>@foreach (var mod in Model.InstalledMods.Where(x => !selectedIds.Contains(x.ModId))) { <option value="@EditModel.SelectionKey(mod)">@mod.Name — version @(string.IsNullOrWhiteSpace(mod.Version) ? string.IsNullOrWhiteSpace(mod.SelectedVersionFolder) ? "non déclarée" : $"PZ {mod.SelectedVersionFolder}" : mod.Version) — @mod.ModId — @(mod.WorkshopId == 0 ? "local" : $"Workshop {mod.WorkshopId}")</option> }</select><button class="button primary" type="submit">Ajouter</button></div>
            </form>
        </div>

        @if (Model.Project.Mods.Count == 0)
        {
            <div class="empty-state compact"><h3>Le pack est vide</h3><p>Ajoutez des mods. En mode Bundle, leurs dossiers et Mod IDs sont préservés sans fusionner leurs répertoires <code>media</code>.</p></div>
        }
        else
        {
            var orderedProjectMods = Model.Project.Mods.OrderBy(item => item.Order).ThenBy(item => item.Name).ToArray();
            <form method="get" class="package-mod-toolbar" aria-label="Recherche dans les mods du pack">
                <input type="hidden" name="tab" value="mods" />
                <input type="hidden" name="conflictFilter" value="@Model.ConflictFilter" />
                <input type="hidden" name="conflictCategory" value="@Model.ConflictCategory" />
                <label><span>Rechercher dans le pack</span><input type="search" name="modQuery" value="@Model.ModQuery" placeholder="Nom, auteur, Mod ID ou Workshop ID…" /></label>
                <label><span>Afficher</span><select name="modFilter"><option value="all" selected="@(Model.ModFilter == "all")">Tous les mods</option><option value="enabled" selected="@(Model.ModFilter == "enabled")">Activés</option><option value="disabled" selected="@(Model.ModFilter == "disabled")">Désactivés</option><option value="manual" selected="@(Model.ModFilter == "manual")">Mise à jour manuelle</option><option value="rights" selected="@(Model.ModFilter == "rights")">Droits à vérifier</option></select></label>
                <button class="button secondary" type="submit">Filtrer</button>
                @if (!string.IsNullOrWhiteSpace(Model.ModQuery) || Model.ModFilter != "all")
                {
                    <a class="button ghost" asp-route-id="@Model.Project.Id" asp-route-tab="mods" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory">Effacer</a>
                }
                <span class="package-mod-count"><strong>@Model.FilteredModCount</strong> sur @Model.Project.Mods.Count mod(s)</span>
            </form>
            <div class="mod-list">
            @foreach (var mod in Model.VisibleProjectMods)
            {
                var reorderTargets = orderedProjectMods.Where(item => item.Id != mod.Id).ToArray();
                var missingRequiredIds = mod.RequiredModIds
                    .Select(ModInfoParser.NormalizeDependencyId)
                    .Where(required => !string.IsNullOrWhiteSpace(required) && !normalizedSelectedIds.Contains(required))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToArray();
                <details class="mod-card" id="mod-@mod.Id.ToString("N")" open="@(Model.ExpandedModId == mod.Id ? "open" : null)">
                    <summary>
                        <span class="order-number">@(mod.Order + 1)</span>
                        <span class="mod-summary-copy"><strong>@mod.Name</strong><small>Mod ID @mod.ModId · @(mod.WorkshopId == 0 ? "source locale" : $"Workshop {mod.WorkshopId}")</small><span class="mod-version-line"><b>Version @mod.DisplayVersion</b><em>Profil PZ @(string.IsNullOrWhiteSpace(mod.SelectedVersionFolder) ? "racine" : mod.SelectedVersionFolder)</em>@if (!string.IsNullOrWhiteSpace(mod.PinnedContentHash)) { <em>Révision @mod.PinnedContentHash[..Math.Min(10, mod.PinnedContentHash.Length)]</em> }</span></span>
                        <span class="mod-summary-status">@if (Directory.Exists(mod.PinnedSourceRoot)) { <span class="snapshot-badge">FIGÉ</span> }<span class="update-policy-badge @(mod.IncludeInGlobalUpdates ? "auto" : "manual")">@(mod.IncludeInGlobalUpdates ? "MÀJ GLOBALE" : "MÀJ MANUELLE")</span><span class="rights-badge @mod.Permission.Status.ToString().ToLowerInvariant()">@mod.Permission.Status</span><span class="mod-expand-hint"><span>Afficher les détails</span><i aria-hidden="true">⌄</i></span></span>
                    </summary>
                    <div class="mod-details">
                        <div class="mod-metadata"><div><span>Version du mod</span><strong>@mod.DisplayVersion</strong></div><div><span>Compatibilité PZ</span><strong>@(string.IsNullOrWhiteSpace(mod.SelectedVersionFolder) ? "racine / legacy" : mod.SelectedVersionFolder)</strong></div><div><span>Origine</span><strong>@mod.SourceModRoot</strong></div><div><span>Révision figée</span><strong>@(Directory.Exists(mod.PinnedSourceRoot) ? $"{mod.PinnedAt?.LocalDateTime:dd/MM/yyyy HH:mm} · {mod.PinnedContentHash[..Math.Min(12, mod.PinnedContentHash.Length)]}…" : "En attente")</strong></div>@if (mod.RequiredModIds.Length > 0) { <div><span>Dépendances</span><strong>@string.Join(", ", mod.RequiredModIds)</strong></div> }@if (mod.MapFolders.Length > 0) { <div><span>Cartes</span><strong>@string.Join(", ", mod.MapFolders)</strong></div> }</div>
                        @if (missingRequiredIds.Length > 0)
                        {
                            <section class="mod-missing-dependencies">
                                <span class="mod-missing-dependencies-icon" aria-hidden="true">!</span>
                                <span><strong>@missingRequiredIds.Length dépendance(s) absente(s)</strong><small>Project Zomboid peut refuser de charger ce mod. Ajoutez chaque source vérifiée avant le prochain build.</small></span>
                                <div class="action-row">
                                @foreach (var requiredModId in missingRequiredIds)
                                {
                                    <form method="post" asp-page-handler="AddMissingDependency" data-loading-title="Ajout de @requiredModId…" data-loading-detail="Recherche locale, vérification Workshop, téléchargement, snapshot et recalcul de l’ordre." data-loading-steps="Recherche de la source|Vérification Workshop|Téléchargement|Création du snapshot|Recalcul de l’ordre">
                                        <input type="hidden" name="modReferenceId" value="@mod.Id" />
                                        <input type="hidden" name="requiredModId" value="@requiredModId" />
                                        <button class="button primary compact" type="submit">Ajouter @requiredModId</button>
                                    </form>
                                }
                                </div>
                            </section>
                        }
                        @if (!string.IsNullOrWhiteSpace(mod.SourceUrl)) { <a href="@mod.SourceUrl" target="_blank" rel="noreferrer">Voir la source originale sur Steam ↗</a> }
                        <section class="mod-reorder-panel" aria-label="Réorganiser @mod.Name">
                            <div class="mod-reorder-heading">
                                <span><span class="eyebrow">ORDRE DE CHARGEMENT</span><strong>Position @(mod.Order + 1) sur @Model.Project.Mods.Count</strong></span>
                                <p>Placez précisément ce mod sans modifier l’ordre relatif des autres éléments.</p>
                            </div>
                            <form method="post" asp-page-handler="Reorder" class="mod-reorder-form" data-loading-title="Réorganisation du pack…" data-loading-detail="Enregistrement du nouvel ordre de chargement et recalcul des positions.">
                                <input type="hidden" name="modReferenceId" value="@mod.Id" />
                                <input type="hidden" name="modQuery" value="@Model.ModQuery" />
                                <input type="hidden" name="modFilter" value="@Model.ModFilter" />
                                <input type="hidden" name="modPage" value="@Model.ModPage" />
                                <div class="mod-reorder-edge-actions">
                                    <button class="button secondary" type="submit" name="placement" value="first" disabled="@(mod.Order == 0)"><span aria-hidden="true">⇤</span> Mettre en premier</button>
                                    <button class="button secondary" type="submit" name="placement" value="last" disabled="@(mod.Order == Model.Project.Mods.Count - 1)">Mettre en dernier <span aria-hidden="true">⇥</span></button>
                                </div>
                                @if (reorderTargets.Length > 0)
                                {
                                    <label class="mod-reorder-target"><span>Mod de référence</span><select name="targetModReferenceId" required>@foreach (var target in reorderTargets) { <option value="@target.Id">#@(target.Order + 1) — @target.Name — @target.ModId</option> }</select></label>
                                    <div class="mod-reorder-relative-actions">
                                        <button class="button ghost" type="submit" name="placement" value="before"><span aria-hidden="true">↑</span> Mettre avant…</button>
                                        <button class="button ghost" type="submit" name="placement" value="after"><span aria-hidden="true">↓</span> Mettre après…</button>
                                    </div>
                                }
                                else
                                {
                                    <p class="mod-reorder-alone">Ce mod est le seul élément du pack.</p>
                                }
                            </form>
                        </section>
                        <form method="post" asp-page-handler="UpdateMod" class="rights-form" data-loading-title="Enregistrement des droits…" data-loading-detail="Mise à jour des informations d’auteur, de licence et des preuves associées.">
                            <input type="hidden" name="modReferenceId" value="@mod.Id" />
                            <div class="form-grid two">
                                <label><span>Statut de l’autorisation</span><select name="permissionStatus">@foreach (var status in Enum.GetValues<PermissionStatus>()) { if (status == mod.Permission.Status) { <option value="@status" selected>@status</option> } else { <option value="@status">@status</option> } }</select></label>
                                <label><span>Auteur / détenteur</span><input name="rightsHolder" value="@mod.Permission.RightsHolder" placeholder="@(string.IsNullOrWhiteSpace(mod.Author) ? "Non déclaré dans mod.info" : mod.Author)" /><small>@(string.IsNullOrWhiteSpace(mod.Author) ? "Aucun auteur déclaré par le mod; vérifiez la fiche Workshop." : $"Prérempli depuis mod.info : {mod.Author}")</small></label>
                                <label><span>Preuve publique / licence</span><input name="publicEvidenceUrl" value="@mod.Permission.PublicEvidenceUrl" placeholder="https://…" /></label>
                                <label><span>Pièce privée locale</span><input name="privateAttachmentPath" value="@mod.Permission.PrivateAttachmentPath" placeholder="Capture ou email exporté — jamais publié" /></label>
                                <label class="full"><span>Notes et conditions reçues</span><textarea name="permissionNotes" rows="2">@mod.Permission.Notes</textarea></label>
                                <label class="switch-row mod-update-policy full">
                                    @if (mod.IncludeInGlobalUpdates) { <input type="checkbox" name="includeInGlobalUpdates" value="true" checked /> } else { <input type="checkbox" name="includeInGlobalUpdates" value="true" /> }
                                    <input type="hidden" name="includeInGlobalUpdates" value="false" />
                                    <span><strong>Inclure dans « Mettre à jour les mods »</strong><small>Désactivez cette option pour conserver indéfiniment la révision figée. La mise à jour individuelle reste disponible.</small></span>
                                </label>
                            </div>
                            <div class="mod-footer-actions"><button class="button secondary" type="submit">Enregistrer les droits et la mise à jour</button></div>
                        </form>
                        <div class="mod-actions">
                            <form method="post" asp-page-handler="RefreshMod" class="mod-refresh-form" data-operation-progress data-loading-title="Mise à jour de @mod.Name…" data-loading-detail="Téléchargement de la source actuelle et remplacement du snapshot de ce mod uniquement." data-loading-steps="Validation du Workshop ID|Téléchargement SteamCMD|Inspection du mod.info|Remplacement du snapshot|Enregistrement" data-confirm-title="Mettre à jour ce mod ?" data-confirm-message="Seul le snapshot de « @mod.Name » sera remplacé par la version actuelle. Ce choix fonctionne même si le mod est exclu de la mise à jour globale." data-confirm-action="Mettre à jour ce mod"><input type="hidden" name="modReferenceId" value="@mod.Id" /><button class="button primary" type="submit">Mettre à jour ce mod</button></form>
                            <form method="post" asp-page-handler="RemoveMod" data-loading-title="Retrait du mod…" data-loading-detail="Mise à jour du projet et suppression de son snapshot privé uniquement." data-confirm-title="Retirer ce mod ?" data-confirm-message="Le mod et son snapshot privé seront retirés du pack. Les fichiers source et l’item Workshop original resteront intacts." data-confirm-action="Retirer du pack" data-confirm-tone="danger"><input type="hidden" name="modReferenceId" value="@mod.Id" /><button class="button danger" type="submit">Retirer</button></form>
                        </div>
                    </div>
                </details>
            }
            </div>
            @if (Model.FilteredModCount == 0)
            {
                <div class="empty-state compact"><h3>Aucun mod ne correspond</h3><p>Effacez la recherche ou changez le filtre pour retrouver la liste complète.</p></div>
            }
            @if (Model.ModPageCount > 1)
            {
                var firstModPage = Math.Max(1, Model.ModPage - 2);
                var lastModPage = Math.Min(Model.ModPageCount, firstModPage + 4);
                firstModPage = Math.Max(1, lastModPage - 4);
                <nav class="conflict-pager package-mod-pager" aria-label="Pages des mods du pack">
                    <span>@Model.FilteredModCount mod(s) · @Model.ModPageSize par page</span>
                    <div>
                        @if (Model.ModPage > 1)
                        {
                            <a asp-route-id="@Model.Project.Id" asp-route-tab="mods" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-modQuery="@Model.ModQuery" asp-route-modFilter="@Model.ModFilter" asp-route-modPage="@(Model.ModPage - 1)">Précédent</a>
                        }
                        @for (var modPageNumber = firstModPage; modPageNumber <= lastModPage; modPageNumber++)
                        {
                            <a class="@(modPageNumber == Model.ModPage ? "active" : null)" asp-route-id="@Model.Project.Id" asp-route-tab="mods" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-modQuery="@Model.ModQuery" asp-route-modFilter="@Model.ModFilter" asp-route-modPage="@modPageNumber">@modPageNumber</a>
                        }
                        @if (Model.ModPage < Model.ModPageCount)
                        {
                            <a asp-route-id="@Model.Project.Id" asp-route-tab="mods" asp-route-conflictFilter="@Model.ConflictFilter" asp-route-conflictCategory="@Model.ConflictCategory" asp-route-modQuery="@Model.ModQuery" asp-route-modFilter="@Model.ModFilter" asp-route-modPage="@(Model.ModPage + 1)">Suivant</a>
                        }
                    </div>
                </nav>
            }
        }
    </section>
</div>

<template data-map-manual-template>
    <article class="map-order-item is-manual" draggable="true" data-map-item data-map-name="">
        <button class="drag-handle" type="button" aria-label="Glisser l’entrée">⋮⋮</button><span class="map-rank" data-map-rank></span>
        <div class="map-order-copy"><div class="map-title-row"><strong data-map-manual-name></strong><span class="priority-badge manual">MANUEL</span></div><small>Entrée brute conservée</small><p>Cette carte n’a pas été détectée dans les snapshots actuels.</p></div>
        <div class="map-order-actions"><button class="icon-button" type="button" data-map-up title="Monter">↑</button><button class="icon-button" type="button" data-map-down title="Descendre">↓</button></div>
    </article>
</template>
