@page
@model PZAdvancedServerManager.App.Pages.Server.IndexModel
@using System.Globalization
@using PZAdvancedServerManager.Core.Pz
@{
    ViewData["Title"] = "Configurations serveur";
}

<a class="back-link" asp-page="/Index">← Tableau de bord</a>
@if (TempData["Message"] is string message) { <div class="toast-message">@message</div> }
@if (TempData["Error"] is string error) { <div class="error-message">@error</div> }

<section class="project-hero workspace-hero">
    <div class="workspace-title"><span class="eyebrow">SERVEURS PROJECT ZOMBOID</span><h1>Serveurs locaux et distants</h1><p>Supervisez séparément les serveurs dédiés, les sessions hébergées par le jeu et les machines distantes.</p></div>
    <div class="project-kpis"><span><strong>@Model.Configs.Count</strong> profils</span><span><strong>@Model.Projects.Count</strong> packs</span><span><strong>INI</strong> sauvegardé avant écriture</span></div>
</section>

<div class="server-layout">
    <aside class="panel server-sidebar">
        <div class="sidebar-heading"><span class="eyebrow">PROFILS DÉTECTÉS</span><span class="count-pill">@Model.Configs.Count</span></div>
        <nav>
            @foreach (var config in Model.Configs)
            {
                <a class="@(Model.Selected?.Name == config.Name ? "active" : "")" asp-route-name="@config.Name"><span class="server-profile-line"><strong>@config.Name</strong><em class="connection-badge @(config.IsRemote ? "remote" : "local")">@(config.IsRemote ? "DISTANT" : "PROFIL LOCAL")</em></span><small>@config.Location</small></a>
            }
        </nav>
        <form method="post" asp-page-handler="Create" class="stack-form create-server-form" data-loading-title="Création du profil serveur…" data-loading-detail="Génération d’une configuration sûre avec les paramètres de base et RCON.">
            <label><span>Nouveau profil</span><input name="serverName" required placeholder="monserveur" /></label>
            <button class="button secondary" type="submit">Créer en local</button>
        </form>
        <details class="remote-profile-creator">
            <summary>Ajouter un serveur distant</summary>
            <form method="post" asp-page-handler="CreateRemote" class="stack-form" data-loading-title="Création du profil RCON distant…" data-loading-detail="Validation de l’adresse RCON, enregistrement sécurisé du profil et préparation des options de coordination." data-loading-steps="Validation RCON|Enregistrement du profil|Préparation de la coordination">
                <label><span>Nom du profil</span><input asp-for="NewRemote.Name" required placeholder="vps-principal" /></label>
                <div class="form-grid two compact-fields"><label><span>Hôte RCON</span><input asp-for="NewRemote.RconHost" required placeholder="server.example.com" /></label><label><span>Port RCON</span><input asp-for="NewRemote.RconPort" type="number" min="1" max="65535" /></label></div>
                <label><span>Mot de passe RCON</span><input asp-for="NewRemote.RconPassword" type="password" required autocomplete="new-password" /></label>
                <label class="switch-row"><input asp-for="NewRemote.AutoRestartAfterRconQuit" /><span><strong>Superviseur avec relance automatique</strong><small>Après publication, le manager envoie save puis quit; systemd, Docker ou votre hébergeur relance Project Zomboid.</small></span></label>
                <details class="optional-connection"><summary>Gestion SSH / INI facultative</summary><div class="stack-form optional-connection-fields">
                    <div class="form-grid two compact-fields"><label><span>Hôte SSH</span><input asp-for="NewRemote.Host" placeholder="server.example.com" /></label><label><span>Port SSH</span><input asp-for="NewRemote.SshPort" type="number" min="1" max="65535" /></label></div>
                    <label><span>Utilisateur SSH</span><input asp-for="NewRemote.SshUser" placeholder="pz" /></label>
                    <label><span>Clé privée — optionnelle si agent SSH</span><input asp-for="NewRemote.SshPrivateKeyPath" placeholder="C:\Users\me\.ssh\id_ed25519" /></label>
                    <label><span>Chemin INI — optionnel</span><input asp-for="NewRemote.RemoteIniPath" placeholder="/home/pz/Zomboid/Server/servertest.ini" /></label>
                    <label><span>Commande de démarrage du jeu — optionnelle</span><input asp-for="NewRemote.StartCommand" placeholder="systemctl start pzserver" /></label>
                    <label class="check-row"><input type="checkbox" name="createConfigIfMissing" value="true" /> Créer l’INI distant s’il n’existe pas</label>
                </div></details>
                <button class="button primary" type="submit">Ajouter le profil RCON</button>
            </form>
        </details>
    </aside>

    <div class="server-content">
    @if (Model.Selected is null)
    {
        <div class="empty-state"><h2>Aucune configuration trouvée</h2><p>Créez un premier profil serveur dans le panneau de gauche.</p></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.ConnectionError))
        {
            <div class="warning-callout connection-error"><strong>Connexion ou configuration indisponible</strong><p>@Model.ConnectionError</p></div>
        }
        <nav class="server-view-tabs" aria-label="Vues du serveur" data-server-view-tabs>
            <button type="button" data-server-view-target="supervision"><span>01</span><strong>Supervision</strong><small>Processus et journal</small></button>
            <button type="button" data-server-view-target="network"><span>02</span><strong>Réseau & RCON</strong><small>Ports et commandes</small></button>
            <button type="button" data-server-view-target="data"><span>03</span><strong>Données</strong><small>Monde et sauvegardes</small></button>
            <button type="button" data-server-view-target="deployment"><span>04</span><strong>Déploiement</strong><small>Connexion et packs</small></button>
        </nav>
        <section class="panel server-command-center"
                 data-server-view="supervision"
                 data-server-runtime
                 data-runtime-endpoint="@Url.Page("/Server/Index", "Runtime", new { name = Model.Selected.Name })"
                 data-runtime-running="@Model.SelectedRuntime.IsRunning.ToString().ToLowerInvariant()"
                 data-runtime-rcon="@Model.SelectedRuntime.IsRconAuthenticated.ToString().ToLowerInvariant()">
            <div class="panel-heading">
                <div><span class="eyebrow">@(Model.Selected.IsRemote ? "SERVEUR DISTANT" : "PROFIL SERVEUR LOCAL") · @Model.Selected.Name</span><h2>Centre de contrôle</h2><p>@Model.Selected.Location</p></div>
                <span class="server-status @Model.RuntimeStatusCss" data-runtime-status>@Model.RuntimeStatusText</span>
            </div>
            @if (Model.Selected.CanManageConfiguration) { <div class="summary-columns">
                <div><strong>Workshop items</strong><span>@Model.WorkshopItems.Count</span><p>@string.Join(" · ", Model.WorkshopItems.Take(6))</p></div>
                <div><strong>Mod IDs</strong><span>@Model.Mods.Count</span><p>@string.Join(" · ", Model.Mods.Take(6))</p></div>
                <div><strong>Cartes</strong><span>@Model.Maps.Count</span><p>@string.Join(" · ", Model.Maps.Take(6))</p></div>
            </div> }
            <div class="server-action-grid">
                @if (!Model.Selected.IsRemote) { <form method="post" asp-page-handler="RepairDedicated" asp-route-name="@Model.Selected.Name" data-operation-progress data-loading-title="Mise à jour du serveur dédié…" data-loading-detail="SteamCMD vérifie les fichiers de l’AppID 380870 et rafraîchit les droits de téléchargement Workshop anonymes." data-loading-steps="Connexion Steam anonyme|Vérification des fichiers|Réparation de l’installation|Rafraîchissement des droits Workshop" data-confirm-title="Mettre à jour et réparer le serveur dédié ?" data-confirm-message="SteamCMD validera toute l’installation Project Zomboid Dedicated Server. Cette opération peut lire plusieurs gigaoctets et restaurer les fichiers d’installation officiels." data-confirm-action="Mettre à jour et réparer"><button class="server-action maintenance-action" type="submit" disabled="@Model.SelectedServerOnline"><span class="server-action-icon">↻</span><span><strong>Mettre à jour et réparer</strong><small>AppID 380870 · SteamCMD anonyme</small></span></button></form> }
                <form method="post" asp-page-handler="Start" asp-route-name="@Model.Selected.Name" class="server-start-form" autocomplete="off" data-loading-title="Démarrage du serveur Project Zomboid…" data-loading-detail="Vérification Workshop, lancement du serveur dédié et initialisation sécurisée du compte admin si nécessaire. La machine hôte ne sera jamais redémarrée.">
                    <button class="server-action primary-action" type="submit" disabled="@(Model.SelectedServerOnline || !Model.SelectedServerCanStart)"><span class="server-action-icon">▶</span><span><strong>@(Model.Selected.IsRemote ? "Démarrer le serveur distant" : "Démarrer le serveur dédié")</strong><small>@(Model.Selected.IsRemote ? (Model.SelectedServerCanStart ? "Commande SSH configurée" : "Commande SSH à configurer") : "Installation Dedicated Server locale")</small></span></button>
                    @if (!Model.Selected.IsRemote)
                    {
                        @if (Model.AdminAccountStatus.IsConfigured)
                        {
                            <div class="admin-account-state configured"><span class="admin-account-state-icon">✓</span><span><strong>Compte admin déjà configuré</strong><small>Démarrage direct sans nouvelle saisie de mot de passe.</small></span></div>
                        }
                        else
                        {
                            <details class="admin-bootstrap" open="@(Model.InitialAdminPasswordRequired ? "open" : null)">
                                <summary><span><strong>Compte admin · première initialisation</strong><small>@(Model.InitialAdminPasswordRequired ? "Mot de passe requis pour créer le compte admin" : "État indéterminé · saisie facultative")</small></span></summary>
                                <div class="admin-bootstrap-fields">
                                    <p><span>@Model.AdminAccountStatus.Detail</span><span>Le mot de passe est transmis directement à l’entrée standard uniquement si Project Zomboid affiche sa demande. Il n’est ni enregistré dans le manager, ni ajouté à la ligne de commande ou aux logs.</span></p>
                                    <label><span>Mot de passe administrateur initial</span><input type="password" name="initialAdminPassword" minlength="1" maxlength="128" required="@Model.InitialAdminPasswordRequired" autocomplete="new-password" /></label>
                                    <label><span>Confirmer le mot de passe</span><input type="password" name="initialAdminPasswordConfirmation" minlength="1" maxlength="128" required="@Model.InitialAdminPasswordRequired" autocomplete="new-password" /></label>
                                </div>
                            </details>
                        }
                    }
                </form>
                <form method="post" asp-page-handler="Stop" asp-route-name="@Model.Selected.Name" data-loading-title="Arrêt propre du serveur…" data-loading-detail="Envoi de save puis quit par RCON et attente de la fermeture complète." data-confirm-title="Sauvegarder et arrêter le serveur ?" data-confirm-message="Le gestionnaire enverra save puis quit par RCON et attendra l’arrêt complet. Aucun arrêt forcé ne sera utilisé." data-confirm-action="Sauvegarder et arrêter" data-confirm-tone="danger"><button class="server-action danger-action" type="submit" disabled="@(!Model.SelectedRconAvailable)"><span class="server-action-icon">■</span><span><strong>Sauvegarder et arrêter</strong><small>save puis quit par RCON</small></span></button></form>
                @if (Model.Selected.IsRemote && Model.Selected.Remote!.AutoRestartAfterRconQuit) { <form method="post" asp-page-handler="RestartRcon" asp-route-name="@Model.Selected.Name" data-loading-title="Redémarrage RCON de Project Zomboid…" data-loading-detail="Sauvegarde du monde, envoi de quit et prise en charge de la relance par le superviseur distant." data-confirm-title="Redémarrer Project Zomboid par RCON ?" data-confirm-message="Le manager enverra save puis quit. Le superviseur distant configuré doit relancer uniquement le processus de jeu." data-confirm-action="Sauvegarder et redémarrer"><button class="server-action primary-action" type="submit" disabled="@(!Model.SelectedRconAvailable)"><span class="server-action-icon">↻</span><span><strong>Redémarrer par RCON</strong><small>save + quit + superviseur</small></span></button></form> }
            </div>
            <div class="runtime-monitor">
                <div class="runtime-monitor-heading">
                    <div><span class="eyebrow">ÉTAT DYNAMIQUE DES SERVEURS</span><h3>Processus Project Zomboid détectés</h3><p data-runtime-detail>@Model.RuntimeStatusDetail</p></div>
                    <span class="runtime-live-indicator"><i></i> Actualisation automatique</span>
                </div>
                <div class="runtime-facts">
                    <span><small>INSTANCE PRINCIPALE</small><strong data-runtime-pid>@(Model.SelectedRuntime.ProcessId is int processId ? $"PID {processId.ToString(CultureInfo.InvariantCulture)}" : "—")</strong></span>
                    <span><small>DÉTECTION</small><strong data-runtime-source>@Model.RuntimeDetectionSource</strong></span>
                    <span><small>DÉMARRÉ</small><strong data-runtime-started>@(Model.SelectedRuntime.StartedAt?.ToLocalTime().ToString("G", CultureInfo.CurrentCulture) ?? "—")</strong></span>
                    <span><small>DERNIÈRE SORTIE</small><strong data-runtime-last-output>@(Model.SelectedRuntime.LastOutputAt?.ToLocalTime().ToString("T", CultureInfo.CurrentCulture) ?? "—")</strong></span>
                </div>
                <div class="runtime-instance-list" data-runtime-instances>
                    @foreach (var instance in Model.SelectedRuntime.Instances)
                    {
                        <article class="runtime-instance @(instance.Origin == ServerRuntimeOrigin.LocalHostedSession ? "hosted" : "dedicated")">
                            <span class="runtime-instance-icon">@(instance.Origin == ServerRuntimeOrigin.LocalHostedSession ? "H" : "D")</span>
                            <div><strong>@IndexModel.RuntimeOriginLabel(instance.Origin)</strong><small>PID @instance.ProcessId · démarré @(instance.StartedAt?.ToLocalTime().ToString("G", CultureInfo.CurrentCulture) ?? "—")</small><code>@instance.ExecutablePath</code></div>
                        </article>
                    }
                </div>
                <div class="warning-callout runtime-instance-warning @(Model.SelectedRuntime.Instances.Count > 1 ? "" : "is-hidden")" data-runtime-instance-warning>
                    <strong>Plusieurs serveurs utilisent le profil @Model.Selected.Name</strong>
                    <p>Une session hébergée et un serveur dédié sont deux processus distincts. Avec le même INI, ils tentent généralement d’utiliser les mêmes ports; conservez une seule instance active par profil.</p>
                </div>
                <div class="warning-callout runtime-rcon-warning @(Model.SelectedRuntime.RconBindFailed ? "" : "is-hidden")" data-runtime-rcon-warning>
                    <strong>Le serveur dédié fonctionne, mais le port RCON est occupé</strong>
                    <p>Choisissez un autre port RCON libre dans « Accès & RCON », arrêtez ensuite le serveur de manière contrôlée, puis relancez-le pour activer la console d’administration.</p>
                </div>
                <div class="process-log-view" data-runtime-log-view>
                    <div class="process-log-toolbar">
                        <div><span class="eyebrow">JOURNAL EN DIRECT</span><strong>@Model.RuntimeLogSource</strong><small data-runtime-log-summary>@Model.SelectedRuntime.Output.Count lignes récentes</small></div>
                        <label class="process-log-search"><span>Rechercher</span><input type="search" placeholder="texte, module, erreur…" data-runtime-log-search /></label>
                        <div class="process-log-filters" role="group" aria-label="Filtrer le journal">
                            <button type="button" class="is-active" data-log-filter="all">Tout <span data-log-count="all">@Model.SelectedRuntime.Output.Count</span></button>
                            <button type="button" data-log-filter="important">Important <span data-log-count="important">0</span></button>
                            <button type="button" data-log-filter="error">Erreurs <span data-log-count="error">0</span></button>
                            <button type="button" data-log-filter="warning">Alertes <span data-log-count="warning">0</span></button>
                        </div>
                    </div>
                    <div class="process-terminal" data-runtime-output aria-live="polite">
                        @if (Model.SelectedRuntime.Output.Count == 0)
                        {
                            <div class="process-terminal-empty"><strong>Aucune sortie disponible</strong><span>Le journal apparaîtra ici dès que le processus écrira une ligne.</span></div>
                        }
                        else
                        {
                            @foreach (var line in Model.SelectedRuntime.Output)
                            {
                                <div class="process-log-line level-@line.Level" data-log-level="@line.Level">
                                    <time>@(line.Timestamp?.ToLocalTime().ToString("HH:mm:ss") ?? $"#{line.Sequence}")</time><span>@line.Level.ToUpperInvariant()</span><code>@line.Message</code>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>

        @if (Model.NetworkInfo is not null)
        {
            <section class="panel server-network-panel" data-server-view="network" hidden>
                <div class="panel-heading">
                    <div><span class="eyebrow">RÉSEAU DU SERVEUR</span><h2>Adresses et ports</h2><p>Valeurs configurées dans le profil et adresses accessibles depuis cette machine.</p></div>
                    <div class="network-state-pills">
                        @if (Model.NetworkInfo.IsPublic is bool isPublic) { <span class="network-state-pill">PUBLIC : @(isPublic ? "OUI" : "NON")</span> }
                        @if (Model.NetworkInfo.IsOpen is bool isOpen) { <span class="network-state-pill">OUVERT : @(isOpen ? "OUI" : "NON")</span> }
                    </div>
                </div>
                <div class="network-overview">
                    <article class="network-address-card">
                        <span class="network-card-label">@(Model.Selected.IsRemote ? "HÔTE CONFIGURÉ" : "IP LOCALES / LAN")</span>
                        <div class="network-address-list">
                            @foreach (var address in Model.NetworkInfo.Addresses) { <code>@address</code> }
                        </div>
                        <small>@(string.IsNullOrWhiteSpace(Model.NetworkInfo.BindAddress) || Model.NetworkInfo.BindAddress is "0.0.0.0" or "::" ? "Écoute sur toutes les interfaces. L’adresse IP publique n’est pas résolue automatiquement." : $"Adresse d’écoute forcée : {Model.NetworkInfo.BindAddress}")</small>
                    </article>
                    <div class="network-port-grid">
                        @if (Model.NetworkInfo.DefaultPort is int defaultPort) { <article><span>Jeu / Steam</span><strong>@defaultPort</strong><small>DefaultPort · UDP</small></article> }
                        @if (Model.NetworkInfo.UdpPort is int udpPort) { <article><span>Jeu direct</span><strong>@udpPort</strong><small>UDPPort · RakNet</small></article> }
                        @if (Model.NetworkInfo.SteamPort1 is int steamPort1) { <article><span>Steam 1</span><strong>@steamPort1</strong><small>SteamPort1</small></article> }
                        @if (Model.NetworkInfo.SteamPort2 is int steamPort2) { <article><span>Steam 2</span><strong>@steamPort2</strong><small>SteamPort2</small></article> }
                        <article class="rcon-port-card @(Model.SelectedRuntime.RconBindFailed ? "port-conflict" : "")" data-runtime-rcon-port><span>Administration RCON</span><strong>@Model.NetworkInfo.RconPort</strong><small>@Model.NetworkInfo.RconHost · TCP</small></article>
                    </div>
                </div>
                @if (!Model.NetworkInfo.ConfigurationAvailable) { <p class="fine-print">Ce profil distant est RCON-only : les ports de jeu ne sont pas lisibles sans accès à l’INI distant.</p> }
            </section>
        }

        @if (Model.SelectedRconAvailable)
        {
            <section class="panel rcon-console-panel" id="rcon-console" data-server-view="network" hidden>
                <div class="panel-heading rcon-console-heading">
                    <div><span class="eyebrow">RCON AUTHENTIFIÉ</span><h2>Console d’administration</h2><p>Historique des commandes envoyées depuis cette session du manager et de leurs réponses.</p></div>
                    @if (Model.RconHistory.Count > 0)
                    {
                        <form method="post" asp-page-handler="ClearRconConsole" asp-route-name="@Model.Selected.Name" data-confirm-title="Effacer l’historique RCON ?" data-confirm-message="Les commandes et réponses conservées en mémoire pour ce profil seront supprimées. Aucun journal Project Zomboid ne sera effacé." data-confirm-action="Effacer l’historique"><button class="button ghost" type="submit">Effacer</button></form>
                    }
                </div>
                <div class="rcon-terminal" data-rcon-transcript aria-live="polite">
                    @if (Model.RconHistory.Count == 0)
                    {
                        <div class="rcon-terminal-empty"><strong>Console prête</strong><span>Envoyez une commande pour afficher sa réponse ici.</span></div>
                    }
                    else
                    {
                        @foreach (var entry in Model.RconHistory)
                        {
                            <article class="rcon-entry @(entry.Succeeded ? "success" : "failure")">
                                <header><time datetime="@entry.Timestamp.ToString("O")">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</time><span>@(entry.Succeeded ? "RÉPONSE" : "ERREUR")</span></header>
                                <code>&gt; @entry.Command</code>
                                <pre>@entry.Response</pre>
                            </article>
                        }
                    }
                </div>
                <form method="post" asp-page-handler="RconCommand" asp-route-name="@Model.Selected.Name" class="rcon-command-form" data-loading-title="Commande RCON…" data-loading-detail="Envoi de la commande au processus Project Zomboid et attente de sa réponse.">
                    <label for="rcon-command">Commande RCON</label>
                    <div class="inline-command"><input id="rcon-command" name="command" required maxlength="256" autocomplete="off" placeholder="players, servermsg…, save…" data-rcon-command /><button class="button primary" type="submit">Envoyer</button></div>
                    <small>RCON retourne uniquement la réponse aux commandes envoyées ; il ne diffuse pas spontanément le fichier server-console.txt.</small>
                </form>
            </section>
        }

        @if (!Model.Selected.IsRemote)
        {
            <section class="panel server-data-panel" data-server-view="data" hidden>
                <div class="panel-heading">
                    <div><span class="eyebrow">DONNÉES DU SERVEUR</span><h2>Monde, joueurs et sauvegardes</h2><p>Gérez le cycle de vie du monde sans modifier le pack, les mods ou les règles Sandbox actuelles.</p></div>
                    <span class="server-status @(Model.WorldDataStatus?.HasData == true ? "online" : "offline")">@(Model.WorldDataStatus?.HasData == true ? "MONDE DÉTECTÉ" : "AUCUN MONDE")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.WorldDataError))
                {
                    <div class="warning-callout"><strong>Données indisponibles</strong><p>@Model.WorldDataError</p></div>
                }
                else if (Model.WorldDataStatus is not null)
                {
                    <div class="world-data-summary">
                        <div><span class="world-data-icon">W</span><span><strong>Fichiers du monde</strong><small>@(Model.WorldDataStatus.HasWorld ? "Présents" : "Absents")</small></span></div>
                        <div><span class="world-data-icon">DB</span><span><strong>Base des joueurs</strong><small>@(Model.WorldDataStatus.HasDatabase ? "Présente" : "Absente")</small></span></div>
                        <div><span class="world-data-icon">B</span><span><strong>Sauvegardes manager</strong><small>@Model.WorldBackups.Count archive(s)</small></span></div>
                        <div><span class="world-data-icon">T</span><span><strong>Dernière activité</strong><small>@(Model.WorldDataStatus.LastModifiedAt?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? "Jamais")</small></span></div>
                    </div>
                    <details class="world-data-paths"><summary>Afficher les chemins contrôlés</summary><div><code>@Model.WorldDataStatus.WorldPath</code><code>@Model.WorldDataStatus.DatabasePath</code></div></details>
                    @if (Model.SelectedServerOnline)
                    {
                        <div class="warning-callout"><strong>Arrêt propre requis</strong><p>Sauvegardez puis arrêtez Project Zomboid par RCON avant toute copie, restauration ou réinitialisation afin d’éviter un monde ou une base SQLite incohérente.</p></div>
                    }
                    <div class="world-data-actions">
                        <form method="post" asp-page-handler="CreateWorldBackup" asp-route-name="@Model.Selected.Name" data-operation-progress data-loading-title="Sauvegarde des données du monde…" data-loading-detail="Inventaire, compression ZIP et vérification SHA-256 du monde, de la base des joueurs et des fichiers de configuration." data-loading-steps="Inventaire des fichiers|Compression ZIP|Empreinte SHA-256|Enregistrement de l’archive">
                            <button class="primary-command backup-command" type="submit" disabled="@(Model.SelectedServerOnline || !Model.WorldDataStatus.HasData)"><span class="primary-command-icon">B</span><span><strong>Créer une sauvegarde</strong><small>Monde + joueurs + copie de secours de la configuration</small></span></button>
                        </form>
                        <form method="post" asp-page-handler="OpenWorldBackupFolder" asp-route-name="@Model.Selected.Name" data-loading-title="Ouverture du dossier…" data-loading-detail="Ouverture du stockage local des archives de ce profil."><button class="button secondary" type="submit">Ouvrir le dossier des sauvegardes</button></form>
                        <form method="post" asp-page-handler="ResetWorld" asp-route-name="@Model.Selected.Name" class="reset-world-form" data-operation-progress data-loading-title="Préparation du fresh start…" data-loading-detail="Une archive complète est créée et vérifiée avant le retrait transactionnel du monde et de la base des joueurs." data-loading-detail-checked="Une archive complète est créée et vérifiée avant le retrait transactionnel du monde et de la base des joueurs." data-loading-detail-unchecked="Le monde et la base des joueurs sont retirés transactionnellement sans créer d’archive préalable." data-loading-steps="Sauvegarde automatique|Empreinte SHA-256|Retrait transactionnel|Vérification du fresh start" data-loading-steps-checked="Sauvegarde automatique|Empreinte SHA-256|Retrait transactionnel|Vérification du fresh start" data-loading-steps-unchecked="Préparation du fresh start|Retrait transactionnel|Vérification du fresh start" data-confirm-toggle="createSafetyBackup" data-confirm-title="Créer un nouveau monde ?" data-confirm-message="Le monde actuel et la base des joueurs seront retirés après création d’une sauvegarde de récupération complète. Le pack, les mods, l’INI et les SandboxVars resteront configurés." data-confirm-message-checked="Le monde actuel et la base des joueurs seront retirés après création d’une sauvegarde de récupération complète. Le pack, les mods, l’INI et les SandboxVars resteront configurés." data-confirm-message-unchecked="ATTENTION : le monde actuel et la base des joueurs seront supprimés sans aucune sauvegarde préalable du manager. Cette décision est irréversible si vous ne possédez pas un autre backup." data-confirm-action="Sauvegarder et créer un monde neuf" data-confirm-action-checked="Sauvegarder et créer un monde neuf" data-confirm-action-unchecked="Supprimer sans sauvegarde et recommencer" data-confirm-tone="danger">
                            <label class="reset-backup-choice"><input type="checkbox" name="createSafetyBackup" value="true" checked /><span><strong>Sauvegarder avant le fresh start</strong><small>Recommandé · crée une archive récupérable du monde et des joueurs</small></span></label>
                            <button class="button danger world-reset-button" type="submit" disabled="@(Model.SelectedServerOnline || !Model.WorldDataStatus.HasData)">Nouveau monde (fresh start)</button>
                        </form>
                    </div>

                    <div class="world-backup-heading"><div><span class="eyebrow">HISTORIQUE RÉCUPÉRABLE</span><h3>Sauvegardes disponibles</h3></div><span class="count-pill">@Model.WorldBackups.Count</span></div>
                    @if (Model.WorldBackups.Count == 0)
                    {
                        <div class="empty-state compact-empty"><h3>Aucune sauvegarde</h3><p>Créez une première archive avant une maintenance importante ou un changement de pack.</p></div>
                    }
                    else
                    {
                        <div class="world-backup-list">
                            @foreach (var backup in Model.WorldBackups)
                            {
                                var reason = backup.Reason switch { "pre-reset" => "Avant fresh start", "pre-restore" => "Avant restauration", _ => "Manuelle" };
                                <article class="world-backup-card">
                                    <div class="world-backup-main">
                                        <span class="backup-reason @(backup.Reason == "manual" ? "manual" : "automatic")">@reason</span>
                                        <div><strong>@backup.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</strong><small>@backup.FileCount.ToString("N0", CultureInfo.CurrentCulture) fichiers · @ServerWorldDataStore.FormatBytes(backup.SourceBytes) → @ServerWorldDataStore.FormatBytes(backup.ArchiveBytes)</small></div>
                                    </div>
                                    <div class="backup-content-tags"><span class="@(backup.HasWorld ? "present" : "missing")">Monde</span><span class="@(backup.HasDatabase ? "present" : "missing")">Joueurs</span><span class="@(backup.HasConfiguration ? "present" : "missing")">Configuration</span></div>
                                    <details class="backup-integrity"><summary>Intégrité et identifiant</summary><code>@backup.Id</code><code>SHA-256 @backup.Sha256</code></details>
                                    <div class="world-backup-actions">
                                        <form method="post" asp-page-handler="RestoreWorldBackup" asp-route-name="@Model.Selected.Name" data-operation-progress data-loading-title="Restauration du monde…" data-loading-detail="Vérification SHA-256, sauvegarde de sécurité de l’état actuel, extraction contrôlée et remplacement transactionnel." data-loading-steps="Intégrité SHA-256|Sauvegarde de sécurité|Extraction contrôlée|Remplacement transactionnel|Vérification finale" data-confirm-title="Restaurer cette sauvegarde ?" data-confirm-message="L’état actuel du monde sera remplacé après création automatique d’une nouvelle sauvegarde de sécurité. Le serveur doit rester arrêté pendant toute l’opération." data-confirm-action="Sauvegarder l’état actuel et restaurer">
                                            <input type="hidden" name="backupId" value="@backup.Id" />
                                            <label class="check-row restore-config-choice"><input type="checkbox" name="restoreConfiguration" value="true" disabled="@(!backup.HasConfiguration)" /> Restaurer aussi l’INI et les fichiers Lua archivés</label>
                                            <button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Restaurer</button>
                                        </form>
                                        <form method="post" asp-page-handler="DeleteWorldBackup" asp-route-name="@Model.Selected.Name" data-confirm-title="Supprimer définitivement cette sauvegarde ?" data-confirm-message="L’archive et son manifeste seront supprimés du stockage du manager. Cette opération ne modifie pas le monde actuellement installé." data-confirm-action="Supprimer l’archive" data-confirm-tone="danger">
                                            <input type="hidden" name="backupId" value="@backup.Id" />
                                            <button class="button danger ghost-danger" type="submit">Supprimer</button>
                                        </form>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            </section>
        }
        else
        {
            <section class="panel server-data-panel remote-data-note" data-server-view="data" hidden><div class="panel-heading"><div><span class="eyebrow">DONNÉES DU SERVEUR DISTANT</span><h2>Backups hébergeur ou accès fichiers requis</h2><p>RCON ne transporte pas les fichiers du monde. Utilisez les snapshots de votre VPS/hébergeur pour l’instant; aucune suppression distante n’est proposée sans chemin de données explicite et vérifiable.</p></div></div></section>
        }

        @if (Model.Selected.IsRemote)
        {
            <section class="panel remote-connection-panel" data-server-view="deployment" hidden>
                <div class="panel-heading"><div><span class="eyebrow">CONNEXION DISTANTE</span><h3>RCON principal · SSH facultatif</h3><p>RCON suffit pour le statut, les commandes, save/quit et la coordination. SSH n’est requis que pour l’INI ou un démarrage explicite.</p></div></div>
                <form method="post" asp-page-handler="SaveRemote" asp-route-name="@Model.Selected.Name" class="form-grid" data-loading-title="Enregistrement du profil distant…" data-loading-detail="Validation des paramètres RCON et, si configurés, test des accès SSH facultatifs." data-loading-steps="Validation RCON|Vérification SSH facultative|Enregistrement atomique">
                    <input asp-for="Remote.Name" type="hidden" />
                    <div class="form-grid two"><label><span>Hôte RCON</span><input asp-for="Remote.RconHost" required /></label><label><span>Port RCON</span><input asp-for="Remote.RconPort" type="number" min="1" max="65535" /></label></div>
                    <label><span>Mot de passe RCON</span><input asp-for="Remote.RconPassword" type="password" autocomplete="new-password" /><small>Nécessaire pour confirmer que Project Zomboid est réellement actif et envoyer save/quit.</small></label>
                    <label class="switch-row"><input asp-for="Remote.AutoRestartAfterRconQuit" /><span><strong>Relance automatique après RCON quit</strong><small>À activer si systemd, Docker ou l’hébergeur relance automatiquement Project Zomboid.</small></span></label>
                    <details class="optional-connection" open="@(Model.Selected.Remote!.HasSshConnection ? "open" : null)"><summary>Gestion SSH / INI facultative</summary><div class="form-grid optional-connection-fields">
                        <div class="form-grid two"><label><span>Hôte SSH</span><input asp-for="Remote.Host" /></label><label><span>Port SSH</span><input asp-for="Remote.SshPort" type="number" min="1" max="65535" /></label></div>
                        <div class="form-grid two"><label><span>Utilisateur SSH</span><input asp-for="Remote.SshUser" /></label><label><span>Clé privée — optionnelle</span><input asp-for="Remote.SshPrivateKeyPath" /></label></div>
                        <label><span>Chemin INI distant — optionnel</span><input asp-for="Remote.RemoteIniPath" /></label>
                        <label><span>Commande pour démarrer Project Zomboid — optionnelle</span><input asp-for="Remote.StartCommand" placeholder="systemctl start pzserver" /></label>
                    </div></details>
                    <div class="action-row"><button class="button primary" type="submit">Enregistrer</button><button class="button secondary" type="submit" formaction="?handler=TestRcon&name=@Uri.EscapeDataString(Model.Selected.Name)" data-loading-title="Test RCON…" data-loading-detail="Authentification réelle auprès du processus Project Zomboid.">Tester RCON</button><button class="button secondary" type="submit" formaction="?handler=TestRemote&name=@Uri.EscapeDataString(Model.Selected.Name)" data-loading-title="Test SSH…" data-loading-detail="Connexion non interactive avec la clé ou l’agent SSH." disabled="@(!Model.Selected.Remote.HasSshConnection)">Tester SSH</button></div>
                </form>
                <form method="post" asp-page-handler="DeleteRemote" asp-route-name="@Model.Selected.Name" data-confirm-title="Retirer ce profil distant ?" data-confirm-message="Seul le profil enregistré dans le manager sera supprimé. Aucun fichier, processus ou service ne sera modifié sur le serveur distant." data-confirm-action="Retirer le profil" data-confirm-tone="danger"><button class="button danger" type="submit">Retirer le profil distant</button></form>
            </section>
        }

        @if (!Model.Selected.CanManageConfiguration)
        {
            <div class="info-callout" data-server-view="deployment" hidden><strong>Profil RCON-only prêt pour la coordination</strong><p>La gestion de l’INI, des listes de mods et des cartes est masquée car aucun chemin SSH n’est configuré. Vous pouvez toujours tester RCON, envoyer des commandes et sélectionner ce profil dans la planification d’un pack.</p></div>
        }
        else
        {
        <section class="panel pack-apply-panel" data-server-view="deployment" hidden>
            <div class="info-callout"><strong>Un Workshop ID est requis pour la distribution automatique</strong><p>Project Zomboid peut charger des fichiers locaux sur le serveur, mais ne les transmet pas aux clients. Sans Workshop, chaque joueur doit installer manuellement la même version; le manager ne présente donc ici que les packs construits et publiés.</p></div>
            <div><span class="eyebrow">APPLICATION SÛRE</span><h3>Installer un pack sur ce serveur</h3><p>Seules les listes <code>WorkshopItems</code>, <code>Mods</code> et <code>Map</code> sont remplacées après sauvegarde.</p></div>
            <form method="post" asp-page-handler="ApplyPack" asp-route-name="@Model.Selected.Name" class="pack-apply-form" data-loading-title="Application du pack au serveur…" data-loading-detail="Sauvegarde du profil puis remplacement contrôlé de WorkshopItems, Mods et Map." data-confirm-title="Appliquer ce pack au serveur ?" data-confirm-message="Les listes WorkshopItems, Mods et Map seront remplacées après création d’une sauvegarde horodatée. Les autres réglages du serveur resteront inchangés." data-confirm-action="Appliquer le pack">
                <select name="projectId" required><option value="">Choisir un pack construit et publié…</option>@foreach (var project in Model.Projects) { <option value="@project.Id">@project.Name — Workshop @(project.PublishedWorkshopId == 0 ? "non publié" : project.PublishedWorkshopId)</option> }</select>
                <button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Appliquer le pack</button>
            </form>
            @if (Model.SelectedServerOnline) { <p class="fine-print warning-text">Arrêtez proprement le serveur avant d’appliquer un pack.</p> }
        </section>

        <div class="workspace server-workspace" data-tabs="server-editor-@Model.Selected.Name">
            <nav class="workspace-tabs" aria-label="Sections du serveur" role="tablist">
                <button type="button" role="tab" data-tab-target="identity">Identité</button>
                <button type="button" role="tab" data-tab-target="access">Accès & RCON</button>
                <button type="button" role="tab" data-tab-target="gameplay">Session</button>
                <button type="button" role="tab" data-tab-target="content">Contenu</button>
                <button type="button" role="tab" data-tab-target="all-settings">INI complet <span>@Model.AllSettings.Count</span></button>
                <button type="button" role="tab" data-tab-target="sandbox">Sandbox <span>@Model.SandboxSettings.Count</span></button>
                <button type="button" role="tab" data-tab-target="lua-files">Spawns & Lua</button>
                <button type="button" role="tab" data-tab-target="raw">INI brut</button>
            </nav>

            <form method="post" asp-page-handler="SaveGuided" asp-route-name="@Model.Selected.Name" class="workspace-form" data-loading-title="Enregistrement de la configuration guidée…" data-loading-detail="Création d’une sauvegarde horodatée puis mise à jour des réglages sélectionnés.">
                <section class="workspace-panel" data-tab-panel="identity" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">VISIBILITÉ</span><h2>Identité du serveur</h2><p>Nom, description et visibilité dans la liste publique.</p></div></div>
                    <div class="form-section-grid">
                        <section class="setting-card wide"><div class="form-grid two"><label><span>Nom public</span><input asp-for="Guided.PublicName" /></label><label class="full"><span>Description publique</span><textarea asp-for="Guided.PublicDescription" rows="4"></textarea></label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">01</span><div><h3>Référencement</h3><p>Contrôle l’apparition dans la liste des serveurs.</p></div></div><label class="switch-row"><input asp-for="Guided.Public" /><span><strong>Serveur public</strong><small>Publier le serveur dans la liste publique.</small></span></label></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">02</span><div><h3>Connexions</h3><p>Autorise les nouveaux joueurs à rejoindre.</p></div></div><label class="switch-row"><input asp-for="Guided.Open" /><span><strong>Serveur ouvert</strong><small>Désactivez pour fermer temporairement les nouvelles connexions.</small></span></label></section>
                    </div>
                </section>

                <section class="workspace-panel" data-tab-panel="access" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">RÉSEAU ET SÉCURITÉ</span><h2>Accès et administration</h2><p>Ports, mots de passe et vérification des fichiers Lua.</p></div></div>
                    <div class="form-section-grid">
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">01</span><div><h3>Joueurs</h3><p>Accès au serveur et capacité maximale.</p></div></div><div class="form-grid"><label><span>Mot de passe joueur <em class="secret-state">@(Model.PlayerPasswordConfigured ? "CONFIGURÉ" : "NON CONFIGURÉ")</em></span><input asp-for="Guided.Password" type="password" autocomplete="new-password" placeholder="@(Model.PlayerPasswordConfigured ? "Laisser vide pour conserver" : "Aucun mot de passe")" /><small>La valeur existante n’est jamais renvoyée au navigateur. Un champ vide la conserve.</small></label>@if (Model.PlayerPasswordConfigured) { <label class="switch-row compact-switch"><input asp-for="Guided.ClearPassword" /><span><strong>Supprimer le mot de passe joueur</strong><small>Action explicite appliquée à l’enregistrement.</small></span></label> }<label><span>Nombre maximal de joueurs</span><input asp-for="Guided.MaxPlayers" type="number" min="1" max="1000" /></label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">02</span><div><h3>Ports</h3><p>Valeurs utilisées par le serveur et RCON.</p></div></div><div class="form-grid two"><label><span>Port du jeu</span><input asp-for="Guided.DefaultPort" type="number" min="1" max="65535" /></label><label><span>Port RCON</span><input asp-for="Guided.RconPort" type="number" min="1" max="65535" /></label></div><label><span>Mot de passe RCON <em class="secret-state">@(Model.RconPasswordConfigured ? "CONFIGURÉ" : "NON CONFIGURÉ")</em></span><input asp-for="Guided.RconPassword" type="password" autocomplete="new-password" placeholder="@(Model.RconPasswordConfigured ? "Laisser vide pour conserver" : "Définir le mot de passe RCON")" /><small>Une nouvelle valeur est écrite puis relue exactement. Un champ vide conserve le secret actuel.</small></label>@if (Model.RconPasswordConfigured) { <label class="switch-row compact-switch"><input asp-for="Guided.ClearRconPassword" /><span><strong>Supprimer le mot de passe RCON</strong><small>L’arrêt propre et les commandes RCON ne fonctionneront plus.</small></span></label> }</section>
                        <section class="setting-card wide"><div class="choice-grid two"><label class="switch-row"><input asp-for="Guided.DoLuaChecksum" /><span><strong>Vérifier les checksums Lua</strong><small>Recommandé : refuse les clients dont les scripts diffèrent.</small></span></label><div class="warning-callout"><strong>Ne désactivez pas cette vérification pour contourner un mismatch</strong><p>Le gestionnaire synchronise les versions; la protection Lua doit rester active.</p></div></div></section>
                    </div>
                </section>

                <section class="workspace-panel" data-tab-panel="gameplay" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">SESSION</span><h2>Comportement multijoueur</h2><p>Réglages courants de pause, PvP, sommeil et sauvegardes.</p></div></div>
                    <div class="form-section-grid">
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">01</span><div><h3>Monde actif</h3><p>Contrôle l’écoulement du temps sans joueurs.</p></div></div><label class="switch-row"><input asp-for="Guided.PauseEmpty" /><span><strong>Pause quand le serveur est vide</strong><small>Évite que le monde continue sans joueurs connectés.</small></span></label></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">02</span><div><h3>PvP et sécurité</h3><p>Combat entre joueurs et système de sécurité.</p></div></div><div class="check-stack"><label><input asp-for="Guided.Pvp" /> Autoriser le PvP</label><label><input asp-for="Guided.SafetySystem" /> Activer le système de sécurité</label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">03</span><div><h3>Sommeil</h3><p>Disponibilité et obligation de dormir.</p></div></div><div class="check-stack"><label><input asp-for="Guided.SleepAllowed" /> Autoriser le sommeil</label><label><input asp-for="Guided.SleepNeeded" /> Rendre le sommeil nécessaire</label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">04</span><div><h3>Sauvegardes</h3><p>Fréquence du monde et nombre de backups serveur.</p></div></div><div class="form-grid two"><label><span>Sauvegarde toutes les X minutes</span><input asp-for="Guided.SaveWorldEveryMinutes" type="number" min="0" max="1440" /><small>0 conserve le comportement par défaut.</small></label><label><span>Nombre de sauvegardes</span><input asp-for="Guided.BackupsCount" type="number" min="0" max="100" /></label></div></section>
                    </div>
                </section>

                <section class="workspace-panel" data-tab-panel="content" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">CATALOGUE ET LISTES EXACTES</span><h2>Workshop, mods et cartes</h2><p>Composez le serveur visuellement depuis le Workshop ou les installations locales, puis ajustez les listes brutes si nécessaire.</p></div><div class="action-row"><a class="button primary" asp-page="/Workshop/Index" asp-route-serverName="@Model.Selected.Name" asp-route-source="workshop">Explorer le Workshop</a><a class="button secondary" asp-page="/Workshop/Index" asp-route-serverName="@Model.Selected.Name" asp-route-source="local">Mods installés</a></div></div>
                    <section class="catalog-launch-card compact-launch"><span class="catalog-launch-mark">W</span><div><strong>Sélection multiple et dépendances</strong><p>Les items choisis sont téléchargés dans le cache du manager, leurs Mod IDs sont lus dans les <code>mod.info</code>, puis ajoutés à ce profil avec une sauvegarde horodatée.</p></div></section>
                    <div class="info-callout"><strong>Versions et configuration serveur</strong><p>Le fichier serveur stocke uniquement les Workshop IDs et Mod IDs. Les versions déclarées, profils PZ et révisions figées restent visibles et vérifiables dans le projet du pack, son manifeste et la fenêtre en jeu.</p></div>
                    <div class="warning-callout"><strong>L’ordre est significatif</strong><p>Les Mod IDs suivent l’ordre de chargement. Pour les cartes, les entrées les plus hautes gagnent les conflits et <code>Muldraugh, KY</code> doit normalement rester en dernier.</p></div>
                    <div class="form-grid">
                        <label><span>WorkshopItems</span><textarea asp-for="Guided.WorkshopItems" rows="4" class="compact-code-editor" spellcheck="false"></textarea><small>IDs numériques séparés par des points-virgules.</small></label>
                        <label><span>Mods</span><textarea asp-for="Guided.Mods" rows="7" class="compact-code-editor" spellcheck="false"></textarea><small>Mod IDs internes séparés par des points-virgules.</small></label>
                        <label><span>Map</span><textarea asp-for="Guided.Map" rows="4" class="compact-code-editor" spellcheck="false"></textarea><small>Dossiers de cartes dans l’ordre de priorité.</small></label>
                    </div>
                </section>

                <div class="workspace-savebar"><span><strong>Éditeur guidé · écriture vérifiée</strong><small>@(Model.SelectedServerOnline ? "Arrêtez le jeu avant de modifier l’INI." : "Sauvegarde horodatée, écriture atomique puis relecture complète.")</small></span><button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Enregistrer les réglages</button></div>
            </form>

            <form method="post" asp-page-handler="SaveAll" asp-route-name="@Model.Selected.Name" class="workspace-form structured-settings-form" data-loading-title="Enregistrement complet de l’INI…" data-loading-detail="Validation typée de toutes les options, sauvegarde horodatée, écriture atomique et relecture." data-confirm-title="Enregistrer tous les réglages INI ?" data-confirm-message="Toutes les valeurs visibles seront validées puis écrites en une opération. Les secrets laissés vides seront conservés." data-confirm-action="Valider et enregistrer">
                <section class="workspace-panel" data-tab-panel="all-settings" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">CONFIGURATION EXHAUSTIVE</span><h2>Tous les réglages du serveur</h2><p>@Model.AllSettings.Count clés détectées directement dans l’INI. Les options ajoutées par une nouvelle version restent automatiquement disponibles.</p></div><span class="count-pill">@Model.AllSettings.Select(x => x.Category).Distinct().Count() groupes</span></div>
                    <div class="info-callout"><strong>Secrets protégés</strong><p>Les mots de passe, tokens et webhooks existants ne sont jamais renvoyés au navigateur. Laissez leur champ vide pour conserver la valeur enregistrée.</p></div>
                    <partial name="_StructuredSettings" model="Model.IniEditor" />
                    <div class="workspace-savebar"><span><strong>INI complet · @Model.AllSettings.Count valeurs</strong><small>@(Model.SelectedServerOnline ? "Arrêtez le jeu avant toute écriture." : "Validation typée, sauvegarde, écriture atomique et relecture.")</small></span><button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Enregistrer toute la configuration</button></div>
                </section>
            </form>

            <form method="post" asp-page-handler="SaveSandbox" asp-route-name="@Model.Selected.Name" class="workspace-form structured-settings-form" data-loading-title="Enregistrement des SandboxVars…" data-loading-detail="Validation de toutes les règles du monde, sauvegarde horodatée, écriture atomique et relecture." data-confirm-title="Enregistrer les règles Sandbox ?" data-confirm-message="Les règles du monde, des zombies et les options de mods seront mises à jour. Le serveur doit rester arrêté." data-confirm-action="Enregistrer SandboxVars">
                <section class="workspace-panel" data-tab-panel="sandbox" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">MONDE, ZOMBIES & MODS</span><h2>SandboxVars complet</h2><p>Éditeur dynamique des règles vanilla et des options ajoutées par les mods. Les tables Lua et commentaires restent en place.</p></div><span class="count-pill">@Model.SandboxSettings.Count variables</span></div>
                    @if (!string.IsNullOrWhiteSpace(Model.SandboxError)) { <div class="warning-callout"><strong>SandboxVars indisponible</strong><p>@Model.SandboxError</p></div> }
                    <partial name="_StructuredSettings" model="Model.SandboxEditor" />
                    @if (Model.SandboxSettings.Count > 0) { <div class="workspace-savebar"><span><strong>SandboxVars · @Model.SandboxSettings.Count variables</strong><small>@(Model.SelectedServerOnline ? "Arrêtez le jeu avant toute écriture." : "Options vanilla et de mods sauvegardées puis relues.")</small></span><button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Enregistrer toutes les règles du monde</button></div> }
                </section>
            </form>

            <form method="post" asp-page-handler="SaveLuaFiles" asp-route-name="@Model.Selected.Name" class="workspace-form" data-loading-title="Enregistrement des fichiers Lua serveur…" data-loading-detail="Validation minimale, sauvegardes horodatées, écritures atomiques et relecture des trois fichiers." data-confirm-title="Enregistrer les fichiers Lua serveur ?" data-confirm-message="SandboxVars, régions et points d’apparition modifiés seront sauvegardés puis remplacés. Le serveur doit rester arrêté." data-confirm-action="Enregistrer les fichiers Lua">
                <section class="workspace-panel" data-tab-panel="lua-files" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">MODE EXPERT COMPLET</span><h2>Sandbox, régions et points d’apparition</h2><p>Accès brut aux fichiers Lua associés au profil. Utilisez l’éditeur guidé Sandbox pour les valeurs courantes et cette vue pour les structures personnalisées.</p></div></div>
                    <div class="warning-callout"><strong>Le code Lua est conservé tel quel</strong><p>Le manager vérifie le type de fichier, sauvegarde l’original et relit l’écriture, mais ne peut pas garantir la logique d’un script personnalisé.</p></div>
                    <div class="lua-file-editors">
                        <details open><summary><span><strong>@(Model.Selected.Name)_SandboxVars.lua</strong><small>Règles du monde, zombies, loot, véhicules et options de mods</small></span></summary><textarea name="sandboxContent" class="config-editor lua-editor" rows="28" spellcheck="false">@Model.SandboxRaw</textarea></details>
                        <details><summary><span><strong>@(Model.Selected.Name)_spawnregions.lua</strong><small>Liste des régions proposées à la création du personnage</small></span></summary><textarea name="spawnRegionsContent" class="config-editor lua-editor" rows="16" spellcheck="false">@Model.SpawnRegionsRaw</textarea></details>
                        <details><summary><span><strong>@(Model.Selected.Name)_spawnpoints.lua</strong><small>Coordonnées d’apparition personnalisées</small></span></summary><textarea name="spawnPointsContent" class="config-editor lua-editor" rows="16" spellcheck="false">@Model.SpawnPointsRaw</textarea></details>
                    </div>
                    <div class="workspace-savebar"><span><strong>Trois fichiers contrôlés</strong><small>@(Model.SelectedServerOnline ? "Arrêtez le jeu avant toute écriture." : "Seuls les fichiers réellement modifiés créent une sauvegarde.")</small></span><button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Enregistrer les fichiers Lua</button></div>
                </section>
            </form>

            <section class="workspace-panel" data-tab-panel="raw" role="tabpanel">
                <div class="panel-heading"><div><span class="eyebrow">MODE EXPERT</span><h2>Fichier INI complet</h2><p>Les clés inconnues, commentaires, encodage et fins de lignes sont préservés.</p></div></div>
                <form method="post" asp-page-handler="Save" asp-route-name="@Model.Selected.Name" data-loading-title="Enregistrement du fichier INI…" data-loading-detail="Création d’une sauvegarde horodatée, écriture atomique puis relecture complète du profil serveur." data-confirm-title="Enregistrer l’INI brut ?" data-confirm-message="Une sauvegarde horodatée sera créée avant l’écriture atomique et le fichier sera relu pour vérifier sa persistance." data-confirm-action="Enregistrer l’INI">
                    <textarea asp-for="RawContent" class="config-editor" spellcheck="false"></textarea>
                    <div class="raw-editor-footer"><p class="fine-print">@(Model.SelectedServerOnline ? "Arrêtez le jeu avant toute écriture : Project Zomboid peut remplacer un INI modifié à chaud." : "Utilisez cet éditeur pour les options non encore exposées dans l’interface guidée.")</p><button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Enregistrer l’INI brut</button></div>
                </form>
            </section>
        </div>
        }
    }
    </div>
</div>
