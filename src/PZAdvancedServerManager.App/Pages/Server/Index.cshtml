@page
@model PZAdvancedServerManager.App.Pages.Server.IndexModel
@{
    ViewData["Title"] = "Configurations serveur";
}

<a class="back-link" asp-page="/Index">← Tableau de bord</a>
@if (TempData["Message"] is string message) { <div class="toast-message">@message</div> }
@if (TempData["Error"] is string error) { <div class="error-message">@error</div> }

<section class="project-hero workspace-hero">
    <div class="workspace-title"><span class="eyebrow">SERVEURS PROJECT ZOMBOID</span><h1>Serveurs locaux et distants</h1><p>Configurez et pilotez uniquement le processus Project Zomboid, sur cette machine ou sur un VPS/dédié.</p></div>
    <div class="project-kpis"><span><strong>@Model.Configs.Count</strong> profils</span><span><strong>@Model.Projects.Count</strong> packs</span><span><strong>INI</strong> sauvegardé avant écriture</span></div>
</section>

<div class="server-layout">
    <aside class="panel server-sidebar">
        <div class="sidebar-heading"><span class="eyebrow">PROFILS DÉTECTÉS</span><span class="count-pill">@Model.Configs.Count</span></div>
        <nav>
            @foreach (var config in Model.Configs)
            {
                <a class="@(Model.Selected?.Name == config.Name ? "active" : "")" asp-route-name="@config.Name"><span class="server-profile-line"><strong>@config.Name</strong><em class="connection-badge @(config.IsRemote ? "remote" : "local")">@(config.IsRemote ? "DISTANT" : "LOCAL")</em></span><small>@config.Location</small></a>
            }
        </nav>
        <form method="post" asp-page-handler="Create" class="stack-form create-server-form" data-loading-title="Création du profil serveur…" data-loading-detail="Génération d’une configuration sûre avec les paramètres de base et RCON.">
            <label><span>Nouveau profil</span><input name="serverName" required placeholder="monserveur" /></label>
            <button class="button secondary" type="submit">Créer en local</button>
        </form>
        <details class="remote-profile-creator">
            <summary>Ajouter un serveur distant</summary>
            <form method="post" asp-page-handler="CreateRemote" class="stack-form" data-loading-title="Connexion au serveur distant…" data-loading-detail="Test SSH, vérification du fichier INI et enregistrement du profil distant.">
                <label><span>Nom du profil</span><input asp-for="NewRemote.Name" required placeholder="vps-principal" /></label>
                <div class="form-grid two compact-fields"><label><span>Hôte SSH</span><input asp-for="NewRemote.Host" required placeholder="server.example.com" /></label><label><span>Port SSH</span><input asp-for="NewRemote.SshPort" type="number" min="1" max="65535" /></label></div>
                <label><span>Utilisateur SSH</span><input asp-for="NewRemote.SshUser" required placeholder="pz" /></label>
                <label><span>Clé privée — optionnelle si agent SSH</span><input asp-for="NewRemote.SshPrivateKeyPath" placeholder="C:\Users\me\.ssh\id_ed25519" /></label>
                <label><span>Chemin INI sur le serveur</span><input asp-for="NewRemote.RemoteIniPath" required placeholder="/home/pz/Zomboid/Server/servertest.ini" /></label>
                <label><span>Commande de démarrage du jeu</span><input asp-for="NewRemote.StartCommand" placeholder="systemctl start pzserver" /><small>Elle doit démarrer Project Zomboid uniquement, jamais redémarrer l’hôte.</small></label>
                <div class="form-grid two compact-fields"><label><span>Hôte RCON</span><input asp-for="NewRemote.RconHost" placeholder="identique à SSH" /></label><label><span>Port RCON</span><input asp-for="NewRemote.RconPort" type="number" min="1" max="65535" /></label></div>
                <label><span>Mot de passe RCON</span><input asp-for="NewRemote.RconPassword" type="password" autocomplete="new-password" /></label>
                <label class="check-row"><input type="checkbox" name="createConfigIfMissing" value="true" /> Créer l’INI distant s’il n’existe pas</label>
                <button class="button primary" type="submit">Tester et ajouter</button>
            </form>
        </details>
    </aside>

    <div class="server-content">
    @if (Model.Selected is null)
    {
        <div class="empty-state"><h2>Aucune configuration trouvée</h2><p>Créez un premier profil serveur dans le panneau de gauche.</p></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.ConnectionError))
        {
            <div class="warning-callout connection-error"><strong>Connexion ou configuration indisponible</strong><p>@Model.ConnectionError</p></div>
        }
        <section class="panel server-command-center">
            <div class="panel-heading">
                <div><span class="eyebrow">@(Model.Selected.IsRemote ? "SERVEUR DISTANT" : "SERVEUR LOCAL") · @Model.Selected.Name</span><h2>Centre de contrôle</h2><p>@Model.Selected.Location</p></div>
                <span class="server-status @(Model.SelectedServerOnline ? "online" : "offline")">@(Model.SelectedServerOnline ? "EN LIGNE · RCON AUTHENTIFIÉ" : "ARRÊTÉ / RCON INDISPONIBLE")</span>
            </div>
            <div class="summary-columns">
                <div><strong>Workshop items</strong><span>@Model.WorkshopItems.Count</span><p>@string.Join(" · ", Model.WorkshopItems.Take(6))</p></div>
                <div><strong>Mod IDs</strong><span>@Model.Mods.Count</span><p>@string.Join(" · ", Model.Mods.Take(6))</p></div>
                <div><strong>Cartes</strong><span>@Model.Maps.Count</span><p>@string.Join(" · ", Model.Maps.Take(6))</p></div>
            </div>
            <div class="server-action-grid">
                <form method="post" asp-page-handler="Start" asp-route-name="@Model.Selected.Name" data-loading-title="Démarrage de Project Zomboid…" data-loading-detail="Lancement du processus de jeu uniquement. La machine hôte ne sera jamais redémarrée."><button class="server-action primary-action" type="submit" disabled="@(Model.SelectedServerOnline || !Model.SelectedServerCanStart)"><span class="server-action-icon">▶</span><span><strong>Démarrer le jeu</strong><small>@(Model.Selected.IsRemote ? (Model.SelectedServerCanStart ? "Commande SSH configurée" : "Commande SSH à configurer") : "Processus local dédié")</small></span></button></form>
                <form method="post" asp-page-handler="Stop" asp-route-name="@Model.Selected.Name" data-loading-title="Arrêt propre du serveur…" data-loading-detail="Envoi de save puis quit par RCON et attente de la fermeture complète." data-confirm-title="Sauvegarder et arrêter le serveur ?" data-confirm-message="Le gestionnaire enverra save puis quit par RCON et attendra l’arrêt complet. Aucun arrêt forcé ne sera utilisé." data-confirm-action="Sauvegarder et arrêter" data-confirm-tone="danger"><button class="server-action danger-action" type="submit" disabled="@(!Model.SelectedServerOnline)"><span class="server-action-icon">■</span><span><strong>Sauvegarder et arrêter</strong><small>save puis quit par RCON</small></span></button></form>
            </div>
        </section>

        @if (Model.Selected.IsRemote)
        {
            <section class="panel remote-connection-panel">
                <div class="panel-heading"><div><span class="eyebrow">CONNEXION DISTANTE</span><h3>SSH pour la configuration et le démarrage</h3><p>RCON reste prioritaire pour le statut, la sauvegarde et l’arrêt. SSH sert à lire l’INI et à relancer uniquement Project Zomboid.</p></div></div>
                <form method="post" asp-page-handler="SaveRemote" asp-route-name="@Model.Selected.Name" class="form-grid" data-loading-title="Vérification de la connexion distante…" data-loading-detail="Test SSH puis enregistrement des paramètres du serveur distant.">
                    <input asp-for="Remote.Name" type="hidden" />
                    <div class="form-grid two"><label><span>Hôte SSH</span><input asp-for="Remote.Host" required /></label><label><span>Port SSH</span><input asp-for="Remote.SshPort" type="number" min="1" max="65535" /></label></div>
                    <div class="form-grid two"><label><span>Utilisateur SSH</span><input asp-for="Remote.SshUser" required /></label><label><span>Clé privée — optionnelle</span><input asp-for="Remote.SshPrivateKeyPath" /></label></div>
                    <label><span>Chemin INI distant</span><input asp-for="Remote.RemoteIniPath" required /></label>
                    <label><span>Commande pour démarrer Project Zomboid uniquement</span><input asp-for="Remote.StartCommand" placeholder="systemctl start pzserver" /><small>Exemples : <code>systemctl start pzserver</code> ou un script qui lance uniquement le serveur de jeu. Les commandes de reboot de l’hôte sont refusées par conception de l’interface.</small></label>
                    <div class="form-grid two"><label><span>Hôte RCON — vide = hôte SSH</span><input asp-for="Remote.RconHost" /></label><label><span>Port RCON</span><input asp-for="Remote.RconPort" type="number" min="1" max="65535" /></label></div>
                    <label><span>Mot de passe RCON</span><input asp-for="Remote.RconPassword" type="password" autocomplete="new-password" /><small>Nécessaire pour confirmer que Project Zomboid est réellement actif et envoyer save/quit.</small></label>
                    <div class="action-row"><button class="button primary" type="submit">Tester et enregistrer</button><button class="button secondary" type="submit" formaction="?handler=TestRemote&name=@Uri.EscapeDataString(Model.Selected.Name)" data-loading-title="Test SSH…" data-loading-detail="Connexion non interactive au serveur distant avec la clé ou l’agent SSH.">Tester SSH</button></div>
                </form>
                <form method="post" asp-page-handler="DeleteRemote" asp-route-name="@Model.Selected.Name" data-confirm-title="Retirer ce profil distant ?" data-confirm-message="Seul le profil enregistré dans le manager sera supprimé. Aucun fichier, processus ou service ne sera modifié sur le serveur distant." data-confirm-action="Retirer le profil" data-confirm-tone="danger"><button class="button danger" type="submit">Retirer le profil distant</button></form>
            </section>
        }

        <section class="panel pack-apply-panel">
            <div><span class="eyebrow">APPLICATION SÛRE</span><h3>Installer un pack sur ce serveur</h3><p>Seules les listes <code>WorkshopItems</code>, <code>Mods</code> et <code>Map</code> sont remplacées après sauvegarde.</p></div>
            <form method="post" asp-page-handler="ApplyPack" asp-route-name="@Model.Selected.Name" class="pack-apply-form" data-loading-title="Application du pack au serveur…" data-loading-detail="Sauvegarde du profil puis remplacement contrôlé de WorkshopItems, Mods et Map." data-confirm-title="Appliquer ce pack au serveur ?" data-confirm-message="Les listes WorkshopItems, Mods et Map seront remplacées après création d’une sauvegarde horodatée. Les autres réglages du serveur resteront inchangés." data-confirm-action="Appliquer le pack">
                <select name="projectId" required><option value="">Choisir un pack construit et publié…</option>@foreach (var project in Model.Projects) { <option value="@project.Id">@project.Name — Workshop @(project.PublishedWorkshopId == 0 ? "non publié" : project.PublishedWorkshopId)</option> }</select>
                <button class="button primary" type="submit" disabled="@Model.SelectedServerOnline">Appliquer le pack</button>
            </form>
            @if (Model.SelectedServerOnline) { <p class="fine-print warning-text">Arrêtez proprement le serveur avant d’appliquer un pack.</p> }
        </section>

        <div class="workspace server-workspace" data-tabs="server-editor-@Model.Selected.Name">
            <nav class="workspace-tabs" aria-label="Sections du serveur" role="tablist">
                <button type="button" role="tab" data-tab-target="identity">Identité</button>
                <button type="button" role="tab" data-tab-target="access">Accès & RCON</button>
                <button type="button" role="tab" data-tab-target="gameplay">Session</button>
                <button type="button" role="tab" data-tab-target="content">Contenu</button>
                <button type="button" role="tab" data-tab-target="raw">INI brut</button>
            </nav>

            <form method="post" asp-page-handler="SaveGuided" asp-route-name="@Model.Selected.Name" class="workspace-form" data-loading-title="Enregistrement de la configuration guidée…" data-loading-detail="Création d’une sauvegarde horodatée puis mise à jour des réglages sélectionnés.">
                <section class="workspace-panel" data-tab-panel="identity" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">VISIBILITÉ</span><h2>Identité du serveur</h2><p>Nom, description et visibilité dans la liste publique.</p></div></div>
                    <div class="form-section-grid">
                        <section class="setting-card wide"><div class="form-grid two"><label><span>Nom public</span><input asp-for="Guided.PublicName" /></label><label class="full"><span>Description publique</span><textarea asp-for="Guided.PublicDescription" rows="4"></textarea></label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">01</span><div><h3>Référencement</h3><p>Contrôle l’apparition dans la liste des serveurs.</p></div></div><label class="switch-row"><input asp-for="Guided.Public" /><span><strong>Serveur public</strong><small>Publier le serveur dans la liste publique.</small></span></label></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">02</span><div><h3>Connexions</h3><p>Autorise les nouveaux joueurs à rejoindre.</p></div></div><label class="switch-row"><input asp-for="Guided.Open" /><span><strong>Serveur ouvert</strong><small>Désactivez pour fermer temporairement les nouvelles connexions.</small></span></label></section>
                    </div>
                </section>

                <section class="workspace-panel" data-tab-panel="access" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">RÉSEAU ET SÉCURITÉ</span><h2>Accès et administration</h2><p>Ports, mots de passe et vérification des fichiers Lua.</p></div></div>
                    <div class="form-section-grid">
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">01</span><div><h3>Joueurs</h3><p>Accès au serveur et capacité maximale.</p></div></div><div class="form-grid"><label><span>Mot de passe joueur</span><input asp-for="Guided.Password" type="password" autocomplete="new-password" /></label><label><span>Nombre maximal de joueurs</span><input asp-for="Guided.MaxPlayers" type="number" min="1" max="1000" /></label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">02</span><div><h3>Ports</h3><p>Valeurs utilisées par le serveur et RCON.</p></div></div><div class="form-grid two"><label><span>Port du jeu</span><input asp-for="Guided.DefaultPort" type="number" min="1" max="65535" /></label><label><span>Port RCON</span><input asp-for="Guided.RconPort" type="number" min="1" max="65535" /></label></div><label><span>Mot de passe RCON</span><input asp-for="Guided.RconPassword" type="password" autocomplete="new-password" /><small>Requis pour l’arrêt propre et la coordination des publications.</small></label></section>
                        <section class="setting-card wide"><div class="choice-grid two"><label class="switch-row"><input asp-for="Guided.DoLuaChecksum" /><span><strong>Vérifier les checksums Lua</strong><small>Recommandé : refuse les clients dont les scripts diffèrent.</small></span></label><div class="warning-callout"><strong>Ne désactivez pas cette vérification pour contourner un mismatch</strong><p>Le gestionnaire synchronise les versions; la protection Lua doit rester active.</p></div></div></section>
                    </div>
                </section>

                <section class="workspace-panel" data-tab-panel="gameplay" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">SESSION</span><h2>Comportement multijoueur</h2><p>Réglages courants de pause, PvP, sommeil et sauvegardes.</p></div></div>
                    <div class="form-section-grid">
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">01</span><div><h3>Monde actif</h3><p>Contrôle l’écoulement du temps sans joueurs.</p></div></div><label class="switch-row"><input asp-for="Guided.PauseEmpty" /><span><strong>Pause quand le serveur est vide</strong><small>Évite que le monde continue sans joueurs connectés.</small></span></label></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">02</span><div><h3>PvP et sécurité</h3><p>Combat entre joueurs et système de sécurité.</p></div></div><div class="check-stack"><label><input asp-for="Guided.Pvp" /> Autoriser le PvP</label><label><input asp-for="Guided.SafetySystem" /> Activer le système de sécurité</label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">03</span><div><h3>Sommeil</h3><p>Disponibilité et obligation de dormir.</p></div></div><div class="check-stack"><label><input asp-for="Guided.SleepAllowed" /> Autoriser le sommeil</label><label><input asp-for="Guided.SleepNeeded" /> Rendre le sommeil nécessaire</label></div></section>
                        <section class="setting-card"><div class="setting-heading"><span class="step-number">04</span><div><h3>Sauvegardes</h3><p>Fréquence du monde et nombre de backups serveur.</p></div></div><div class="form-grid two"><label><span>Sauvegarde toutes les X minutes</span><input asp-for="Guided.SaveWorldEveryMinutes" type="number" min="0" max="1440" /><small>0 conserve le comportement par défaut.</small></label><label><span>Nombre de sauvegardes</span><input asp-for="Guided.BackupsCount" type="number" min="0" max="100" /></label></div></section>
                    </div>
                </section>

                <section class="workspace-panel" data-tab-panel="content" role="tabpanel">
                    <div class="panel-heading"><div><span class="eyebrow">CATALOGUE ET LISTES EXACTES</span><h2>Workshop, mods et cartes</h2><p>Composez le serveur visuellement depuis le Workshop ou les installations locales, puis ajustez les listes brutes si nécessaire.</p></div><div class="action-row"><a class="button primary" asp-page="/Workshop/Index" asp-route-serverName="@Model.Selected.Name" asp-route-source="workshop">Explorer le Workshop</a><a class="button secondary" asp-page="/Workshop/Index" asp-route-serverName="@Model.Selected.Name" asp-route-source="local">Mods installés</a></div></div>
                    <section class="catalog-launch-card compact-launch"><span class="catalog-launch-mark">W</span><div><strong>Sélection multiple et dépendances</strong><p>Les items choisis sont téléchargés dans le cache du manager, leurs Mod IDs sont lus dans les <code>mod.info</code>, puis ajoutés à ce profil avec une sauvegarde horodatée.</p></div></section>
                    <div class="info-callout"><strong>Versions et configuration serveur</strong><p>Le fichier serveur stocke uniquement les Workshop IDs et Mod IDs. Les versions déclarées, profils PZ et révisions figées restent visibles et vérifiables dans le projet du pack, son manifeste et la fenêtre en jeu.</p></div>
                    <div class="warning-callout"><strong>L’ordre est significatif</strong><p>Les Mod IDs suivent l’ordre de chargement. Pour les cartes, les entrées les plus hautes gagnent les conflits et <code>Muldraugh, KY</code> doit normalement rester en dernier.</p></div>
                    <div class="form-grid">
                        <label><span>WorkshopItems</span><textarea asp-for="Guided.WorkshopItems" rows="4" class="compact-code-editor" spellcheck="false"></textarea><small>IDs numériques séparés par des points-virgules.</small></label>
                        <label><span>Mods</span><textarea asp-for="Guided.Mods" rows="7" class="compact-code-editor" spellcheck="false"></textarea><small>Mod IDs internes séparés par des points-virgules.</small></label>
                        <label><span>Map</span><textarea asp-for="Guided.Map" rows="4" class="compact-code-editor" spellcheck="false"></textarea><small>Dossiers de cartes dans l’ordre de priorité.</small></label>
                    </div>
                </section>

                <div class="workspace-savebar"><span><strong>Éditeur guidé</strong><small>Une seule sauvegarde horodatée est créée pour l’ensemble des changements.</small></span><button class="button primary" type="submit">Enregistrer les réglages</button></div>
            </form>

            <section class="workspace-panel" data-tab-panel="raw" role="tabpanel">
                <div class="panel-heading"><div><span class="eyebrow">MODE EXPERT</span><h2>Fichier INI complet</h2><p>Les clés inconnues, commentaires, encodage et fins de lignes sont préservés.</p></div></div>
                <form method="post" asp-page-handler="Save" asp-route-name="@Model.Selected.Name" data-loading-title="Enregistrement du fichier INI…" data-loading-detail="Création d’une sauvegarde horodatée puis écriture atomique du profil serveur." data-confirm-title="Enregistrer l’INI brut ?" data-confirm-message="Une sauvegarde horodatée sera créée avant l’écriture atomique du fichier serveur." data-confirm-action="Enregistrer l’INI">
                    <textarea asp-for="RawContent" class="config-editor" spellcheck="false"></textarea>
                    <div class="raw-editor-footer"><p class="fine-print">Utilisez cet éditeur pour les options non encore exposées dans l’interface guidée.</p><button class="button primary" type="submit">Enregistrer l’INI brut</button></div>
                </form>
            </section>
        </div>
    }
    </div>
</div>
