<!DOCTYPE html>
@using System.Diagnostics
@{
    var assetInstance = Process.GetCurrentProcess().StartTime.ToUniversalTime().Ticks;
    var requestPath = Context.Request.Path.Value ?? "/";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isServerArea = requestPath.StartsWith("/Server", StringComparison.OrdinalIgnoreCase);
    var isAdminArea = requestPath.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase);
    var isDashboard = requestPath is "/" or "/Index";
    var isModpacksHome = requestPath.StartsWith("/Modpacks", StringComparison.OrdinalIgnoreCase);
    var isPackArea = isModpacksHome || requestPath.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase) || requestPath.StartsWith("/Workshop", StringComparison.OrdinalIgnoreCase);
    var accountName = User.Identity?.Name ?? "Administrateur";
    var accountInitial = accountName.Trim().Length > 0 ? accountName.Trim()[0].ToString().ToUpperInvariant() : "A";
    var appVersion = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "dev";
    var currentTitle = ViewData["Title"]?.ToString() ?? "PZ Advanced Server Manager";
}
<html lang="fr" data-theme="light" aria-busy="true">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PZ Advanced Server Manager</title>
    <script>document.documentElement.dataset.theme = localStorage.getItem('pzasm-theme') || 'light';</script>
    <style>
        html[aria-busy="true"] { cursor: progress; }
        html[aria-busy="true"]::before { content: ""; position: fixed; z-index: 4998; inset: 0; background: rgba(55, 61, 57, .28); backdrop-filter: grayscale(.68) saturate(.5) brightness(.9) blur(3px); }
        html[aria-busy="true"]::after { content: "PZ   Chargement de l’interface…"; position: fixed; z-index: 4999; top: 50%; left: 50%; width: min(420px, calc(100vw - 32px)); padding: 28px 32px; translate: -50% -50%; border: 1px solid #b8c9a9; border-radius: 18px; box-shadow: 0 24px 60px rgba(24, 35, 26, .28); color: #17251b; background: #fff; font: 700 17px/1.4 system-ui, sans-serif; text-align: center; }
        html[data-theme="dark"][aria-busy="true"]::before { background: rgba(5, 7, 8, .42); backdrop-filter: grayscale(.58) saturate(.54) brightness(.74) blur(3px); }
        html[data-theme="dark"][aria-busy="true"]::after { border-color: #496b38; color: #eef7e9; background: #111a13; }
    </style>
    <script>
        (() => {
            let navigationPending = false;
            const useInitialPageLoading = true;

            const getOverlay = () => document.querySelector('[data-loading-overlay]');
            const show = (nextTitle, nextDetail) => {
                const overlay = getOverlay();
                if (!overlay) return;
                const title = overlay.querySelector('[data-loading-title]');
                const detail = overlay.querySelector('[data-loading-detail]');
                if (title) title.textContent = nextTitle || 'Chargement de la page…';
                if (detail) detail.textContent = nextDetail || 'Préparation de la prochaine vue et actualisation des informations.';
                document.documentElement.setAttribute('aria-busy', 'true');
                document.documentElement.classList.add('has-loading-overlay');
                document.body?.classList.add('is-loading');
                overlay.hidden = false;
                requestAnimationFrame(() => overlay.classList.add('is-visible'));
            };

            const reset = () => {
                navigationPending = false;
                const overlay = getOverlay();
                if (overlay) {
                    overlay.hidden = true;
                    overlay.classList.remove('is-visible', 'has-error', 'has-detailed-progress');
                }
                document.documentElement.removeAttribute('aria-busy');
                document.documentElement.classList.remove('has-loading-overlay');
                document.body?.classList.remove('is-loading');
            };

            document.addEventListener('click', event => {
                if (document.documentElement.dataset.pzasmUiReady === 'true') return;
                if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                if (!(event.target instanceof Element)) return;
                const link = event.target.closest('a[href]');
                if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
                const destination = new URL(link.href, window.location.href);
                if (destination.origin !== window.location.origin) return;
                if (destination.pathname === window.location.pathname && destination.search === window.location.search && destination.hash) return;
                event.preventDefault();
                if (navigationPending) return;
                navigationPending = true;
                show(link.dataset.loadingTitle, link.dataset.loadingDetail);
                window.setTimeout(() => window.location.assign(destination.href), 140);
            }, true);

            document.addEventListener('submit', event => {
                if (document.documentElement.dataset.pzasmUiReady === 'true') return;
                const form = event.target;
                if (!(form instanceof HTMLFormElement) || form.dataset.loadingSkip === 'true') return;
                if (form.dataset.confirmTitle || form.dataset.dependencyPreflightUrl) return;
                const submitter = event.submitter instanceof HTMLElement ? event.submitter : null;
                show(
                    submitter?.dataset.loadingTitle || form.dataset.loadingTitle || 'Traitement en cours…',
                    submitter?.dataset.loadingDetail || form.dataset.loadingDetail || 'Veuillez patienter pendant que PZASM termine cette opération.');
            }, true);

            const hasRenderablePageContent = () => {
                const main = document.querySelector('main');
                if (!main) return false;
                return Array.from(main.children).some(child =>
                    !child.matches('script, style, [hidden]') &&
                    (child.children.length > 0 || (child.textContent || '').trim().length > 0));
            };

            const pageReadyObserver = new MutationObserver(() => {
                const overlay = getOverlay();
                if (useInitialPageLoading && overlay?.hidden) {
                    show('Chargement de la page…', 'Préparation de la vue et actualisation des informations.');
                }
                if (!hasRenderablePageContent() && !document.querySelector('[data-page-ready]')) return;
                pageReadyObserver.disconnect();
                reset();
            });
            pageReadyObserver.observe(document.documentElement, { childList: true, subtree: true });
            document.addEventListener('DOMContentLoaded', reset, { once: true });
            window.addEventListener('pageshow', reset);
            document.documentElement.dataset.pzasmCriticalLoadingReady = 'true';
            window.pzasmCriticalLoadingReady = true;
            window.pzasmCriticalLoadingReset = reset;
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css?instance=@assetInstance" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css?instance=@assetInstance" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css?instance=@assetInstance" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "has-app-shell" : "has-auth-shell")">
    <div class="confirmation-overlay" data-confirm-dialog hidden>
        <section class="confirmation-card" role="dialog" aria-modal="true" aria-labelledby="confirmation-title" aria-describedby="confirmation-message">
            <span class="confirmation-mark" aria-hidden="true">?</span>
            <div class="confirmation-copy">
                <span class="eyebrow">CONFIRMATION REQUISE</span>
                <h2 id="confirmation-title" data-confirm-dialog-title>Confirmer l’opération</h2>
                <p id="confirmation-message" data-confirm-dialog-message>Vérifiez les conséquences avant de continuer.</p>
            </div>
            <div class="confirmation-actions">
                <button class="button ghost" type="button" data-confirm-cancel>Annuler</button>
                <button class="button secondary" type="button" data-confirm-secondary hidden>Continuer sans les dépendances</button>
                <button class="button primary" type="button" data-confirm-accept>Confirmer</button>
            </div>
        </section>
    </div>
    <div class="loading-overlay" data-loading-overlay hidden aria-live="polite" aria-atomic="true">
        <div class="loading-card" role="dialog" aria-modal="true" aria-labelledby="loading-dialog-title">
            <div class="loading-emblem" aria-hidden="true">
                <span>PZ</span>
                <span class="loading-spinner"></span>
            </div>
            <div class="loading-copy">
                <span class="eyebrow">OPÉRATION EN COURS</span>
                <strong id="loading-dialog-title" data-loading-title>Chargement…</strong>
                <p data-loading-detail>Veuillez patienter quelques instants.</p>
                <div class="loading-stage" data-loading-stage hidden><span data-loading-counter>0 / 0</span><strong data-loading-current>Préparation…</strong></div>
            </div>
            <div class="loading-track" aria-hidden="true"><span data-loading-track></span></div>
            <div class="loading-progress-list" data-loading-progress-list hidden></div>
            <section class="loading-interaction" data-loading-interaction hidden aria-live="assertive">
                <span class="eyebrow" data-loading-interaction-eyebrow>VALIDATION STEAM GUARD</span>
                <strong data-loading-interaction-title>Autoriser cette machine</strong>
                <p data-loading-interaction-message>Entrez le code actuel affiché par l’application Steam ou reçu par e-mail.</p>
                <div class="steam-guard-mobile" data-loading-interaction-mobile hidden>
                    <div class="steam-guard-mobile-status"><span aria-hidden="true"></span><div><strong>Approbation mobile en attente</strong><small>Ouvrez la notification Steam, vérifiez la demande puis approuvez-la. SteamCMD détectera automatiquement la confirmation.</small></div></div>
                    <details class="steam-guard-qr-note"><summary>Pourquoi aucun QR n’est affiché ?</summary><p>Steam propose le QR dans son client et sur ses pages web, mais SteamCMD n’expose aucun QR pour cette session de publication. Un QR web séparé ne connecterait pas SteamCMD.</p></details>
                </div>
                <label data-loading-interaction-code-field><span>Code Steam Guard</span><input type="text" inputmode="text" autocomplete="one-time-code" maxlength="12" data-loading-interaction-code /></label>
                <small data-loading-interaction-error hidden>Un code Steam Guard est requis.</small>
                <div class="loading-interaction-actions">
                    <button class="button ghost" type="button" data-loading-interaction-cancel>Annuler</button>
                    <button class="button secondary" type="button" data-loading-interaction-secondary hidden>Réessayer l’approbation mobile</button>
                    <button class="button primary" type="button" data-loading-interaction-submit>Valider et continuer</button>
                </div>
            </section>
            <div class="loading-actions"><button class="button ghost" type="button" data-loading-cancel hidden>Annuler l’opération</button><button class="button secondary loading-close" type="button" data-loading-close hidden>Fermer</button></div>
        </div>
    </div>
    @if (isAuthenticated)
    {
        <div class="app-frame" data-app-frame>
            <div class="sidebar-scrim" data-sidebar-close hidden></div>
            <aside class="app-sidebar" data-app-sidebar aria-label="Navigation principale">
                <a class="app-brand" asp-area="" asp-page="/Index" aria-label="PZ Advanced Server Manager — Tableau de bord">
                    <span class="brand-mark">PZ</span>
                    <span class="app-brand-copy"><strong>Advanced Server</strong><small>Manager</small></span>
                </a>

                <nav class="primary-navigation">
                    <span class="navigation-label">Espace de travail</span>
                    <a class="@(isDashboard ? "is-active" : null)" asp-area="" asp-page="/Index" aria-current="@(isDashboard ? "page" : null)">
                        <svg class="ui-icon" aria-hidden="true"><use href="#icon-grid"></use></svg><span>Tableau de bord</span>
                    </a>
                    <a class="@(isPackArea ? "is-active" : null)" asp-area="" asp-page="/Modpacks/Index" aria-current="@(isPackArea ? "page" : null)">
                        <svg class="ui-icon" aria-hidden="true"><use href="#icon-package"></use></svg><span>Modpacks</span>
                    </a>
                    <a class="@(isServerArea ? "is-active" : null)" asp-area="" asp-page="/Server/Index" aria-current="@(isServerArea ? "page" : null)">
                        <svg class="ui-icon" aria-hidden="true"><use href="#icon-server"></use></svg><span>Serveurs</span>
                    </a>

                    @if (User.IsInRole("Administrator"))
                    {
                        <span class="navigation-label navigation-label-spaced">Administration</span>
                        <a class="@(isAdminArea ? "is-active" : null)" asp-area="" asp-page="/Admin/Users" aria-current="@(isAdminArea ? "page" : null)">
                            <svg class="ui-icon" aria-hidden="true"><use href="#icon-users"></use></svg><span>Utilisateurs</span>
                        </a>
                    }
                </nav>

                <div class="sidebar-status">
                    <span class="status-dot is-online" aria-hidden="true"></span>
                    <span><strong>Manager opérationnel</strong><small>Version @appVersion</small></span>
                </div>
            </aside>

            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-context">
                        <button class="topbar-menu-button" type="button" data-sidebar-toggle aria-label="Ouvrir la navigation" aria-expanded="false">
                            <svg class="ui-icon" aria-hidden="true"><use href="#icon-menu"></use></svg>
                        </button>
                        <nav class="topbar-breadcrumb" aria-label="Fil d’Ariane">
                            @if (isDashboard)
                            {
                                <svg class="ui-icon breadcrumb-home-icon" aria-hidden="true"><use href="#icon-home"></use></svg><strong>Tableau de bord</strong>
                            }
                            else
                            {
                                <a asp-page="/Index" aria-label="Tableau de bord"><svg class="ui-icon breadcrumb-home-icon" aria-hidden="true"><use href="#icon-home"></use></svg><span>Tableau de bord</span></a>
                                <svg class="ui-icon breadcrumb-separator" aria-hidden="true"><use href="#icon-chevron"></use></svg>
                                @if (isPackArea && !isModpacksHome)
                                {
                                    <a asp-page="/Modpacks/Index">Modpacks</a>
                                    <svg class="ui-icon breadcrumb-separator" aria-hidden="true"><use href="#icon-chevron"></use></svg>
                                }
                                else if (isAdminArea)
                                {
                                    <span>Administration</span>
                                    <svg class="ui-icon breadcrumb-separator" aria-hidden="true"><use href="#icon-chevron"></use></svg>
                                }
                                <strong>@currentTitle</strong>
                            }
                        </nav>
                    </div>
                    <div class="app-preferences" aria-label="Préférences et compte">
                        <label class="language-control"><span class="visually-hidden">Langue</span><select data-language-select aria-label="Langue de l’interface"><option value="fr">FR</option><option value="en">EN</option><option value="es">ES</option><option value="de">DE</option><option value="pt-BR">PT</option><option value="zh-CN">中文</option></select></label>
                        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Changer le thème"><span data-theme-icon aria-hidden="true">☀</span><span data-theme-label>Mode clair</span></button>
                        <details class="account-menu">
                            <summary aria-label="Ouvrir le menu du compte"><span class="account-avatar">@accountInitial</span><span class="account-menu-copy"><strong>@accountName</strong><small>Compte administrateur</small></span><svg class="ui-icon" aria-hidden="true"><use href="#icon-chevron-down"></use></svg></summary>
                            <div class="account-popover">
                                <div><strong>@accountName</strong><small>Session active</small></div>
                                <form method="post" asp-page="/Account/Logout"><button class="button ghost compact" type="submit"><svg class="ui-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>Déconnexion</button></form>
                            </div>
                        </details>
                    </div>
                </header>

                <main role="main" class="app-content">
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    <span>&copy; 2026 LemonCorp · PZ Advanced Server Manager</span><span>Project Zomboid et Steam appartiennent à leurs détenteurs respectifs.</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <header class="auth-topbar">
            <a class="app-brand" asp-area="" asp-page="/Index"><span class="brand-mark">PZ</span><span class="app-brand-copy"><strong>Advanced Server</strong><small>Manager</small></span></a>
            <div class="app-preferences" aria-label="Préférences d’affichage">
                <label class="language-control"><span class="visually-hidden">Langue</span><select data-language-select aria-label="Langue de l’interface"><option value="fr">FR</option><option value="en">EN</option><option value="es">ES</option><option value="de">DE</option><option value="pt-BR">PT</option><option value="zh-CN">中文</option></select></label>
                <button class="theme-toggle" type="button" data-theme-toggle aria-label="Changer le thème"><span data-theme-icon aria-hidden="true">☀</span><span data-theme-label>Mode clair</span></button>
            </div>
        </header>
        <main role="main" class="auth-content">
            @RenderBody()
        </main>
    }
    <span data-page-ready hidden></span>

    <svg class="svg-sprite" aria-hidden="true">
        <symbol id="icon-grid" viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" /></symbol>
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6" /></symbol>
        <symbol id="icon-package" viewBox="0 0 24 24"><path d="m12 3 8 4.2v9.6L12 21l-8-4.2V7.2L12 3Zm0 0v9m8-4.8-8 4.8-8-4.8" /></symbol>
        <symbol id="icon-server" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6" /></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM17 11a3 3 0 0 0 0-6M21 20v-2a4 4 0 0 0-3-3.8" /></symbol>
        <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></symbol>
        <symbol id="icon-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
        <symbol id="icon-logout" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5" /></symbol>
    </svg>

    <iframe name="pzasm-download-frame" title="Téléchargements PZASM" hidden></iframe>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (() => {
            const sources = [
                '@Url.Content($"~/js/site.js?instance={assetInstance}")',
                '@Url.Content($"~/js/site-i18n.js?instance={assetInstance}")',
                '@Url.Content($"~/lib/bootstrap/dist/js/bootstrap.bundle.min.js?instance={assetInstance}")'
            ];

            const load = source => new Promise(resolve => {
                const script = document.createElement('script');
                script.src = source;
                script.async = true;
                script.addEventListener('load', () => resolve({ source, loaded: true }), { once: true });
                script.addEventListener('error', () => resolve({ source, loaded: false }), { once: true });
                document.body.appendChild(script);
            });

            const start = async () => {
                document.documentElement.dataset.pzasmRuntimeLoading = 'true';
                const results = await Promise.all(sources.map(load));
                document.documentElement.dataset.pzasmRuntimeLoading = 'false';
                if (results.some(result => !result.loaded))
                    document.documentElement.dataset.pzasmRuntimeError = 'true';
            };

            if (document.readyState === 'complete') void start();
            else window.addEventListener('load', () => void start(), { once: true });
        })();
    </script>
</body>
</html>
